---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE, DEVELOPER_NAME } from "../../data/site";
import { getReadingTime } from "../../utils/readingTime";

const allPosts = await getCollection("blog");

const posts = allPosts
  .filter((p) => import.meta.env.DEV || !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const byYear: Record<number, typeof posts> = {};
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear[year]) byYear[year] = [];
  byYear[year].push(post);
}
const years = Object.keys(byYear).map(Number).sort((a, b) => b - a);
const allTags = [...new Set(posts.flatMap((p) => p.data.tags ?? []))].sort();

function formatDate(date: Date) {
  return date.toLocaleDateString("es-CO", { month: "short", day: "2-digit" });
}

const avgRead = posts.length > 0
  ? Math.round(
      posts.reduce((acc, p) => acc + getReadingTime(p.id, p.data.readingTime), 0) / posts.length
    )
  : 5;
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`Blog — ${SITE_TITLE}`}
      description="Artículos técnicos sobre desarrollo Full Stack, arquitectura de software, Spring Boot, React, agentes de IA y mejores prácticas."
    />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <Header />

    <main id="main-content">
      <!-- Blog Hero (Terminal CLI) -->
      <section class="blog-hero">
        <div class="blog-hero-scanlines" aria-hidden="true"></div>
        <div class="container">
          <div class="hero-prompt-line">
            <span class="hero-user" aria-hidden="true">{DEVELOPER_NAME.toLowerCase().replace(/\s+/g, "")}@angelcorzo</span><span class="hero-sep" aria-hidden="true">:</span><span class="hero-path" aria-hidden="true">~/blog</span><span class="hero-dollar" aria-hidden="true"> $</span>
          </div>

          <h1 class="hero-command">
            ls -la posts/ <span class="hero-cursor" aria-hidden="true">&#9608;</span>
          </h1>

          <p class="hero-comment">
            escritos sobre arquitectura de software, backend resilient y el oficio de construir productos
          </p>

          <!-- Interactive Search & Filter Bar -->
          <div class="filter-terminal" role="search" aria-label="Buscador y filtros del blog">
            <div class="filter-prompt-row">
              <span class="filter-prompt" aria-hidden="true">grep -i</span>
              <div class="filter-input-wrap">
                <input
                  type="text"
                  id="blogSearchInput"
                  class="filter-input"
                  placeholder='buscar por título, concepto o tecnología (ej. "spring", "monolito")...'
                  autocomplete="off"
                  spellcheck="false"
                  aria-label="Buscar artículos en el blog"
                />
                <button
                  type="button"
                  id="clearFilterBtn"
                  class="clear-filter-btn"
                  aria-label="Limpiar búsqueda y filtros"
                  style="display: none;"
                >
                  <span aria-hidden="true">&times;</span> esc
                </button>
              </div>
            </div>

            <!-- Tags Filter Chips -->
            {allTags.length > 0 && (
              <div class="hero-tags" role="toolbar" aria-label="Filtrar por etiqueta">
                <span class="tags-label" aria-hidden="true">tags:</span>
                <button
                  type="button"
                  class="tag-filter-chip active"
                  data-tag="all"
                  aria-pressed="true"
                  aria-label="Mostrar todos los artículos"
                >
                  * todas ({posts.length})
                </button>
                {allTags.map((tag) => {
                  const tagCount = posts.filter((p) => p.data.tags?.includes(tag)).length;
                  return (
                    <button
                      type="button"
                      class="tag-filter-chip"
                      data-tag={tag}
                      aria-pressed="false"
                      aria-label={`Filtrar por etiqueta ${tag} (${tagCount} artículos)`}
                    >
                      #{tag} <span class="tag-chip-count">({tagCount})</span>
                    </button>
                  );
                })}
              </div>
            )}

            <!-- Active Filter Status Indicator -->
            <div id="filterStatus" class="filter-status" aria-live="polite">
              <span class="status-match-count" id="matchCount">Mostrando {posts.length} de {posts.length} artículos</span>
            </div>
          </div>
        </div>
      </section>

      <!-- Blog Listing Section -->
      <section class="blog-listing">
        <div class="container">
          {posts.length === 0 && (
            <div class="empty-state">
              <div class="empty-terminal">
                <div class="empty-terminal-bar" aria-hidden="true">
                  <span class="dot dot-red"></span>
                  <span class="dot dot-yellow"></span>
                  <span class="dot dot-green"></span>
                  <span class="empty-terminal-title">bash</span>
                </div>
                <div class="empty-terminal-body">
                  <p class="empty-line">
                    <span class="empty-prompt" aria-hidden="true">$</span>
                    find ./posts -name "*.mdx"
                  </p>
                  <p class="empty-output">find: no matching files yet</p>
                  <p class="empty-cursor-line">
                    <span class="empty-prompt" aria-hidden="true">$</span>
                    <span class="empty-cursor" aria-hidden="true">&#9608;</span>
                  </p>
                </div>
              </div>
              <a href="/contacto" class="notify-link">
                <span aria-hidden="true">&gt;</span>
                Avisame cuando haya novedades
              </a>
            </div>
          )}

          {posts.length > 0 && (
            <div class="posts-container">
              <div class="posts-main">
                <!-- Filter Empty State (Hidden by default, shown by JS when no search matches) -->
                <div id="noMatchesState" class="no-matches-state" style="display: none;" role="status">
                  <div class="no-matches-box">
                    <span class="no-matches-icon" aria-hidden="true">!</span>
                    <p class="no-matches-text">
                      grep: no se encontraron artículos para <code id="noMatchesQuery">""</code>
                    </p>
                    <button type="button" id="resetSearchBtn" class="reset-search-btn">
                      <span aria-hidden="true">&gt;</span> Limpiar filtros y ver todos
                    </button>
                  </div>
                </div>

                {years.map((year) => (
                  <div class="year-group" data-year={year}>
                    <div class="year-header">
                      <span class="year-label">{year}</span>
                      <span class="year-count">
                        <span class="year-visible-count">{byYear[year].length}</span> de {byYear[year].length} {byYear[year].length === 1 ? "artículo" : "artículos"}
                      </span>
                    </div>

                    <ul class="post-list" role="list">
                      {byYear[year].map((post, idx) => {
                        const tagsStr = (post.data.tags ?? []).join(" ");
                        const searchContent = `${post.data.title} ${post.data.description} ${tagsStr}`.toLowerCase();
                        const readingMinutes = getReadingTime(post.id, post.data.readingTime);
                        return (
                          <li
                            class="post-row"
                            data-post-item
                            data-search={searchContent}
                            data-tags={JSON.stringify(post.data.tags ?? [])}
                            style={`--row-idx: ${idx};`}
                          >
                            <a href={`/blog/${post.id}`} class="post-row-link">
                              <span class="row-idx" aria-hidden="true">
                                {String(idx + 1).padStart(2, "0")}
                              </span>
                              <span class="row-perms" aria-hidden="true">
                                {post.data.draft ? "-rw-------" : "-rw-r--r--"}
                              </span>
                              <time class="row-date" datetime={post.data.pubDate.toISOString()}>
                                {formatDate(post.data.pubDate)}
                              </time>
                              <span class="row-size" aria-label={`Lectura: ${readingMinutes} minutos`}>
                                {readingMinutes}m
                              </span>
                              <span class="row-name">
                                <span class="row-name-text">{post.data.title}</span>
                                {post.data.draft && <span class="row-draft-badge">DRAFT</span>}
                              </span>
                              {(post.data.tags ?? []).length > 0 && (
                                <span class="row-tags" aria-hidden="true">
                                  {(post.data.tags ?? []).slice(0, 3).map((t) => (
                                    <span class="row-tag">#{t}</span>
                                  ))}
                                </span>
                              )}
                              <span class="row-arrow" aria-hidden="true">&#8594;</span>
                            </a>

                            <!-- Mobile Metadata Subrow (Visible only on <= 768px) -->
                            <div class="row-mobile-meta">
                              <time datetime={post.data.pubDate.toISOString()} class="mobile-meta-date">
                                {formatDate(post.data.pubDate)}
                              </time>
                              <span class="mobile-meta-sep" aria-hidden="true">&bull;</span>
                              <span class="mobile-meta-time">{readingMinutes} min lectura</span>
                              {(post.data.tags ?? []).length > 0 && (
                                <>
                                  <span class="mobile-meta-sep" aria-hidden="true">&bull;</span>
                                  <div class="mobile-meta-tags">
                                    {(post.data.tags ?? []).slice(0, 2).map((t) => (
                                      <span class="mobile-tag">#{t}</span>
                                    ))}
                                  </div>
                                </>
                              )}
                            </div>

                            <p class="post-desc">{post.data.description}</p>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                ))}
              </div>

              <!-- Sidebar: Stats, Tag Index & Feed -->
              <aside class="posts-sidebar" aria-label="Información complementaria del blog">
                <!-- Stats Widget -->
                <div class="sidebar-widget">
                  <div class="sidebar-widget-header">
                    <span class="sidebar-widget-title">stats.sys</span>
                  </div>
                  <dl class="sidebar-stats">
                    <div class="stat-row">
                      <dt class="stat-key">total_posts</dt>
                      <dd class="stat-val">{posts.length}</dd>
                    </div>
                    <div class="stat-row">
                      <dt class="stat-key">tags_index</dt>
                      <dd class="stat-val">{allTags.length}</dd>
                    </div>
                    <div class="stat-row">
                      <dt class="stat-key">avg_read_time</dt>
                      <dd class="stat-val">{avgRead} min</dd>
                    </div>
                    <div class="stat-row">
                      <dt class="stat-key">license</dt>
                      <dd class="stat-val">MIT</dd>
                    </div>
                  </dl>
                </div>

                <!-- Tags Directory Widget -->
                {allTags.length > 0 && (
                  <div class="sidebar-widget">
                    <div class="sidebar-widget-header">
                      <span class="sidebar-widget-title">tags.directory</span>
                    </div>
                    <ul class="sidebar-tags">
                      {allTags.map((tag) => {
                        const count = posts.filter((p) => p.data.tags?.includes(tag)).length;
                        return (
                          <li>
                            <button
                              type="button"
                              class="sidebar-tag-btn"
                              data-sidebar-tag={tag}
                              aria-label={`Filtrar por ${tag}`}
                            >
                              <span class="sidebar-tag-name">#{tag}</span>
                              <span class="sidebar-tag-count">{count}</span>
                            </button>
                          </li>
                        );
                      })}
                    </ul>
                  </div>
                )}

              </aside>
            </div>
          )}
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ─── Hero ─────────────────────────────────────────────────── */

  .blog-hero {
    background: linear-gradient(180deg, var(--crust) 0%, var(--base) 100%);
    padding: 68px 0 48px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.1);
  }

  .blog-hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(var(--overlay0-rgb), 0.015) 3px,
      rgba(var(--overlay0-rgb), 0.015) 6px
    );
    pointer-events: none;
  }

  .blog-hero .container {
    position: relative;
    z-index: 1;
  }

  .hero-prompt-line {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    margin-bottom: 14px;
    user-select: none;
  }

  .hero-user { color: var(--green); font-weight: 700; }
  .hero-sep { color: var(--overlay1); }
  .hero-path { color: var(--sky); font-weight: 700; }
  .hero-dollar { color: var(--overlay1); }

  .hero-command {
    font-family: var(--font-mono);
    font-size: clamp(1.75rem, 4.2vw, 2.9rem);
    font-weight: 700;
    color: var(--text);
    margin: 0 0 16px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .hero-cursor {
    color: var(--mauve);
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .hero-comment {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    color: var(--subtext0);
    margin: 0 0 28px;
    max-width: 65ch;
    line-height: 1.6;
  }

  .hero-comment::before {
    content: "// ";
    color: var(--overlay0);
  }

  /* ─── Filter & Search Terminal Bar ─────────────────────────── */

  .filter-terminal {
    background: rgba(var(--surface0-rgb), 0.4);
    border: 1px solid rgba(var(--overlay0-rgb), 0.14);
    backdrop-filter: blur(6px);
    border-radius: 8px;
    padding: 14px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 820px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .filter-prompt-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .filter-prompt {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--peach);
    flex-shrink: 0;
    user-select: none;
  }

  .filter-input-wrap {
    display: flex;
    align-items: center;
    position: relative;
    flex: 1;
  }

  .filter-input {
    width: 100%;
    background: var(--base);
    border: 1px solid rgba(var(--overlay0-rgb), 0.2);
    border-radius: 6px;
    padding: 8px 12px;
    padding-right: 64px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .filter-input:focus {
    border-color: var(--mauve);
    box-shadow: 0 0 0 2px rgba(var(--mauve-rgb), 0.2);
  }

  .filter-input::placeholder {
    color: var(--overlay1);
    font-style: italic;
    opacity: 0.8;
  }

  .clear-filter-btn {
    position: absolute;
    right: 8px;
    background: var(--surface1);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    color: var(--subtext0);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 2px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .clear-filter-btn:hover {
    color: var(--red);
    border-color: rgba(var(--red-rgb), 0.5);
  }

  .hero-tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tags-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--overlay1);
    margin-right: 4px;
    user-select: none;
  }

  .tag-filter-chip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--sky);
    background: rgba(var(--sky-rgb), 0.06);
    border: 1px solid rgba(var(--sky-rgb), 0.16);
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 160ms var(--ease-out), color 160ms var(--ease-out), border-color 160ms var(--ease-out), transform 140ms var(--ease-out);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .tag-filter-chip:active {
    transform: scale(0.96);
  }

  .tag-chip-count {
    font-size: 0.68rem;
    color: var(--overlay1);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) and (pointer: fine) {
    .tag-filter-chip:hover {
      background: rgba(var(--sky-rgb), 0.14);
      color: var(--sapphire);
      border-color: rgba(var(--sky-rgb), 0.35);
    }
  }

  .tag-filter-chip.active {
    background: var(--mauve);
    color: var(--crust);
    border-color: var(--mauve);
    font-weight: 700;
  }

  .tag-filter-chip.active .tag-chip-count {
    color: rgba(var(--crust-rgb), 0.8);
  }

  .filter-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--overlay1);
    padding-top: 4px;
    border-top: 1px dashed rgba(var(--overlay0-rgb), 0.12);
    font-variant-numeric: tabular-nums;
  }

  /* ─── Listing ───────────────────────────────────────────────── */

  .blog-listing {
    padding: 56px 0 110px;
  }

  /* ─── Empty state ───────────────────────────────────────────── */

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding: 48px 0;
  }

  .empty-terminal {
    width: 100%;
    max-width: 540px;
    background: var(--mantle);
    border: 1px solid rgba(var(--overlay0-rgb), 0.2);
    border-radius: 8px;
    overflow: hidden;
  }

  .empty-terminal-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    background: var(--surface0);
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.15);
  }

  .dot { width: 10px; height: 10px; border-radius: 50%; }
  .dot-red { background: var(--red); }
  .dot-yellow { background: var(--yellow); }
  .dot-green { background: var(--green); }

  .empty-terminal-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--subtext0);
    margin-left: auto;
  }

  .empty-terminal-body {
    padding: 16px 20px 20px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .empty-line, .empty-cursor-line {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    margin: 0;
  }

  .empty-cursor-line { margin-top: 8px; }

  .empty-prompt { color: var(--green); font-weight: 700; }
  .empty-output { color: var(--overlay1); padding-left: 20px; margin: 0; }

  .empty-cursor {
    color: var(--mauve);
    animation: blink 1.1s step-end infinite;
  }

  .notify-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--mauve);
    text-decoration: none;
    padding: 10px 20px;
    border: 1px solid rgba(var(--mauve-rgb), 0.3);
    border-radius: 6px;
    background: rgba(var(--mauve-rgb), 0.05);
    transition: background 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .notify-link:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .notify-link:hover {
      background: rgba(var(--mauve-rgb), 0.12);
      border-color: rgba(var(--mauve-rgb), 0.5);
      color: var(--lavender);
    }
  }

  /* ─── Search No Matches Box ─────────────────────────────────── */

  .no-matches-state {
    padding: 32px 0;
  }

  .no-matches-box {
    background: var(--surface0);
    border: 1px dashed rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    padding: 24px;
    text-align: center;
    font-family: var(--font-mono);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .no-matches-icon {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--peach);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(var(--peach-rgb), 0.3);
    border-radius: 50%;
    background: rgba(var(--peach-rgb), 0.08);
  }

  .no-matches-text {
    font-size: 0.9rem;
    color: var(--subtext0);
    margin: 0;
  }

  .no-matches-text code {
    color: var(--mauve);
    background: var(--base);
    padding: 2px 6px;
    border-radius: 4px;
    border: 1px solid rgba(var(--overlay0-rgb), 0.2);
  }

  .reset-search-btn {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--mauve);
    background: rgba(var(--mauve-rgb), 0.08);
    border: 1px solid rgba(var(--mauve-rgb), 0.3);
    border-radius: 6px;
    padding: 8px 16px;
    cursor: pointer;
    transition: background 160ms var(--ease-out), border-color 160ms var(--ease-out), color 160ms var(--ease-out), transform 140ms var(--ease-out);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .reset-search-btn:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .reset-search-btn:hover {
      background: rgba(var(--mauve-rgb), 0.18);
      border-color: rgba(var(--mauve-rgb), 0.5);
      color: var(--lavender);
    }
  }

  /* ─── Posts Grid ────────────────────────────────────────────── */

  .posts-container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 48px;
    align-items: start;
  }

  /* ─── Year Group ────────────────────────────────────────────── */

  .year-group { margin-bottom: 48px; }
  .year-group:last-child { margin-bottom: 0; }

  .year-header {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.2);
  }

  .year-label {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--mauve);
  }

  .year-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--overlay1);
    font-variant-numeric: tabular-nums;
  }

  /* ─── Post List ─────────────────────────────────────────────── */

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @keyframes rowEnter {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .post-row {
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.12);
    padding: 14px 0 16px;
    transition: background 160ms var(--ease-out);
    animation: rowEnter 240ms var(--ease-out) backwards;
    animation-delay: calc(var(--row-idx, 0) * 45ms);
