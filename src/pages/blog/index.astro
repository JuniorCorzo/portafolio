    .hero-command { font-size: 1.6rem; }
    .filter-prompt { display: none; }
  }
</style>

<script>
  function initBlogListing() {
    const searchInput = document.getElementById("blogSearchInput") as HTMLInputElement | null;
    const clearBtn = document.getElementById("clearFilterBtn");
    const tagChips = document.querySelectorAll<HTMLButtonElement>(".tag-filter-chip");
    const sidebarTagBtns = document.querySelectorAll<HTMLButtonElement>("[data-sidebar-tag]");
    const postItems = document.querySelectorAll<HTMLElement>("[data-post-item]");
    const yearGroups = document.querySelectorAll<HTMLElement>(".year-group");
    const matchCountEl = document.getElementById("matchCount");
    const noMatchesState = document.getElementById("noMatchesState");
    const noMatchesQueryEl = document.getElementById("noMatchesQuery");
    const resetSearchBtn = document.getElementById("resetSearchBtn");

    if (!searchInput || postItems.length === 0) return;

    let activeTag: string = "all";

    // Read initial tag from URL search params (e.g. /blog?tag=spring-boot)
    const urlParams = new URLSearchParams(window.location.search);
    const initialTag = urlParams.get("tag");
    const initialQuery = urlParams.get("q");

    if (initialTag) {
      activeTag = initialTag;
    }
    if (initialQuery) {
      searchInput.value = initialQuery;
    }

    function applyFilters() {
      const query = (searchInput?.value ?? "").trim().toLowerCase();
      let visibleCount = 0;

      // Toggle clear button
      if (clearBtn) {
        clearBtn.style.display = query || activeTag !== "all" ? "inline-flex" : "none";
      }

      // Update chip active states
      tagChips.forEach((chip) => {
        const chipTag = chip.getAttribute("data-tag");
        const isActive = chipTag === activeTag;
        chip.classList.toggle("active", isActive);
        chip.setAttribute("aria-pressed", String(isActive));
      });

      // Filter each post item
      postItems.forEach((item) => {
        const searchData = item.getAttribute("data-search") ?? "";
        let itemTags: string[] = [];
        try {
          itemTags = JSON.parse(item.getAttribute("data-tags") ?? "[]");
        } catch {}

        const matchesQuery = !query || searchData.includes(query);
        const matchesTag = activeTag === "all" || itemTags.includes(activeTag);

        const isVisible = matchesQuery && matchesTag;
        item.style.display = isVisible ? "" : "none";
        if (isVisible) visibleCount++;
      });

      // Check year group visibility and update year counts
      yearGroups.forEach((yg) => {
        const visibleInYear = yg.querySelectorAll<HTMLElement>('[data-post-item]:not([style*="display: none"])').length;
        const countSpan = yg.querySelector(".year-visible-count");
        if (countSpan) countSpan.textContent = String(visibleInYear);
        yg.style.display = visibleInYear > 0 ? "" : "none";
      });

      // Match count feedback
      if (matchCountEl) {
        if (query || activeTag !== "all") {
          const filterDesc = activeTag !== "all" ? ` en #${activeTag}` : "";
          matchCountEl.textContent = `Mostrando ${visibleCount} de ${postItems.length} artículos${filterDesc}`;
        } else {
          matchCountEl.textContent = `Mostrando ${postItems.length} de ${postItems.length} artículos`;
        }
      }

      // Show/hide no matches state
      if (noMatchesState) {
        if (visibleCount === 0) {
          noMatchesState.style.display = "block";
          if (noMatchesQueryEl) {
            noMatchesQueryEl.textContent = query || `#${activeTag}`;
          }
        } else {
          noMatchesState.style.display = "none";
        }
      }
    }

    // Search input handler
    searchInput.addEventListener("input", applyFilters);

    // Keyboard shortcuts: ESC to clear, / to focus search
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && (searchInput.value || activeTag !== "all")) {
        searchInput.value = "";
        activeTag = "all";
        applyFilters();
      } else if (e.key === "/" && document.activeElement !== searchInput) {
        e.preventDefault();
        searchInput.focus();
        searchInput.select();
      }
    });

    // Tag chips click handler
    tagChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const tag = chip.getAttribute("data-tag") ?? "all";
        activeTag = tag;
        applyFilters();
      });
    });

    // Sidebar tags click handler
    sidebarTagBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const tag = btn.getAttribute("data-sidebar-tag") ?? "all";
        activeTag = tag;
        applyFilters();
        // Scroll smoothly to filter terminal
        document.querySelector(".filter-terminal")?.scrollIntoView({ behavior: "smooth", block: "center" });
      });
    });

    // Clear and reset buttons
    clearBtn?.addEventListener("click", () => {
      searchInput.value = "";
      activeTag = "all";
      applyFilters();
      searchInput.focus();
    });

    resetSearchBtn?.addEventListener("click", () => {
      searchInput.value = "";
      activeTag = "all";
      applyFilters();
      searchInput.focus();
    });

    // Initial run
    applyFilters();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBlogListing);
  } else {
    initBlogListing();
  }
  document.addEventListener("astro:page-load", initBlogListing);
</script>
