---
import { getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";
import { getReadingTime } from "../../utils/readingTime";

export async function getStaticPaths() {
  const posts = (
    await getCollection("blog", ({ data }) =>
      import.meta.env.DEV ? true : !data.draft
    )
  ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      prevPost:
        index + 1 < posts.length
          ? { id: posts[index + 1].id, title: posts[index + 1].data.title }
          : undefined,
      nextPost:
        index > 0
          ? { id: posts[index - 1].id, title: posts[index - 1].data.title }
          : undefined,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings } = await render(post);

// Resolves reading time from frontmatter or cached src/data/reading-times.json (fallback 5 min)
const readingTimeCalc: number = getReadingTime(post.id, post.data.readingTime);
---

<BlogPost
  slug={post.id}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  heroImage={post.data.heroImage}
  tags={post.data.tags}
  draft={post.data.draft}
  readingTime={post.data.readingTime}
  readingTimeCalc={readingTimeCalc}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</BlogPost>
