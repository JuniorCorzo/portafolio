---
import { getCollection, render } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!doctype html>
<html lang="es">
  <head>
    <BaseHead
      title={`${post.data.title} — Blog | ${SITE_TITLE}`}
      description={post.data.description}
    />
    <meta name="theme-color" content="#1e1e2e" />
  </head>
  <body>
    <Header />
    <main>
      <article class="post-hero">
        <div class="post-container">
          <header class="post-header">
            <span class="file-comment">// blog/{post.id}.md</span>
            <h1>$ {post.data.title}</h1>
            <p class="post-meta">
              {new Date(post.data.pubDate).toLocaleDateString("es-CO", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
              {post.data.tags && (
                <span class="post-tags">
                  {post.data.tags.map((tag) => (
                    <span class="tag-chip">#{tag}</span>
                  ))}
                </span>
              )}
            </p>
          </header>
          <div class="post-content">
            <Content />
          </div>
          <a href="/blog" class="back-link">
            <span class="prompt">&gt;</span> Volver al blog
          </a>
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>

<style>
  .post-hero {
    padding: 80px 24px;
    background: linear-gradient(135deg, var(--crust) 0%, var(--base) 100%);
    min-height: 60vh;
  }

  .post-container {
    max-width: 800px;
    margin: 0 auto;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .file-comment {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--overlay1);
    margin-bottom: 8px;
    user-select: none;
  }

  .post-header h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 16px 0;
  }

  .post-meta {
    color: var(--subtext0);
    font-size: 0.95rem;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  .post-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .tag-chip {
    background: rgba(var(--sky-rgb), 0.1);
    color: var(--sky);
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .post-content {
    color: var(--subtext0);
    font-size: 1.05rem;
    line-height: 1.8;
    margin-bottom: 40px;
  }

  .post-content :global(h2) {
    color: var(--text);
    font-size: 1.75rem;
    margin-top: 40px;
    margin-bottom: 16px;
  }

  .post-content :global(p) {
    margin-bottom: 16px;
  }

  .post-content :global(ul) {
    padding-left: 24px;
    margin-bottom: 16px;
  }

  .post-content :global(li) {
    margin-bottom: 8px;
  }

  .back-link {
    color: var(--sky);
    font-weight: 600;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .back-link:hover {
    color: var(--sapphire);
  }

  .prompt {
    font-family: var(--font-mono);
    user-select: none;
  }

  @media (max-width: 640px) {
    .post-hero {
      padding: 60px 24px;
    }

    .post-header h1 {
      font-size: 1.75rem;
    }
  }
</style>
