---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { DEVELOPER_NAME } from "../consts";

type Props = CollectionEntry<"study-case">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://angelcorzo.dev");
const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  headline: title,
  description: description,
  url: canonicalURL.toString(),
  datePublished: pubDate,
  dateModified: updatedDate || pubDate,
  author: {
    "@type": "Person",
    name: DEVELOPER_NAME,
    url: "https://angelcorzo.dev",
  },
  publisher: {
    "@type": "Person",
    name: DEVELOPER_NAME,
  },
  inLanguage: "es",
};
---

<html lang="es">
  <head>
    <BaseHead title={title} description={description} />
    <script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
    <style is:global>
      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
      }

      .hero-image {
        width: 100%;
      }

      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      .prose {
        max-width: 80ch;
        margin: auto;
        color: var(--text);
      }

      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }

      .title h1 {
        margin: 0 0 0.5em 0;
      }

      .date {
        margin-bottom: 0.5em;
        color: var(--text);
      }

      .last-updated-on {
        font-style: italic;
      }

      .table-wrapper {
        overflow-x: auto;
        max-width: 100%;
        margin-bottom: 8px;
      }

      pre.mermaid {
        padding: 0;
        border-radius: 12px;
        background-color: var(--surface0);
      }

      @media (max-width: 768px) {
        .prose {
          padding: 1rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <img width={1020} height={510} src={heroImage} alt={title} loading="lazy" decoding="async" />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            <div class="date">
              <FormattedDate date={pubDate} />
              {
                updatedDate && (
                  <div class="last-updated-on">
                    Last updated on <FormattedDate date={updatedDate} />
                  </div>
                )
              }
            </div>
            <h1>{title}</h1>
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
