---
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { DEVELOPER_NAME } from "../consts";

export type Heading = {
  depth: number;
  slug: string;
  text: string;
};

export type PostNav = {
  id: string;
  title: string;
};

type Props = CollectionEntry<"blog">["data"] & {
  slug?: string;
  readingTimeCalc?: number;
  headings?: Heading[];
  prevPost?: PostNav;
  nextPost?: PostNav;
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  draft = false,
  readingTime,
  readingTimeCalc,
  slug,
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://angelcorzo.dev"
);
const imageUrl = heroImage
  ? new URL(heroImage, canonicalURL).toString()
  : new URL("/images/og.png", canonicalURL).toString();

const minutes = readingTime ?? readingTimeCalc ?? 5;

const formattedDate = pubDate.toLocaleDateString("es-CO", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const isoDate = pubDate.toISOString();
const isoUpdated = updatedDate ? updatedDate.toISOString() : isoDate;

const blogPostSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description: description,
  image: [imageUrl],
  url: canonicalURL.toString(),
  datePublished: isoDate,
  dateModified: isoUpdated,
  author: {
    "@type": "Person",
    name: DEVELOPER_NAME,
    url: "https://angelcorzo.dev",
  },
  publisher: {
    "@type": "Person",
    name: DEVELOPER_NAME,
  },
  inLanguage: "es",
  keywords: tags.join(", "),
};

// Neovim-style file path
const postSlug = slug ?? Astro.url.pathname.replace(/\/+$/, "").split("/").pop() ?? "post";
const filePath = `~/blog/${postSlug}.mdx`;

// Filter headings for table of contents (h2 and h3)
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<html lang="es">
  <head>
    <BaseHead title={`${title} — Blog | ${DEVELOPER_NAME}`} description={description} image={heroImage} />
    <script type="application/ld+json" set:html={JSON.stringify(blogPostSchema)} />
  </head>

  <body>
    <Header />

    <!-- Neovim-style buffer tabline (sticky below header) -->
    <aside class="nvim-tabline" aria-label="Información del buffer y lectura">
      <div class="reading-progress-bar" id="readingProgress" aria-hidden="true"></div>
      <div class="nvim-tabline-inner">
        <div class="nvim-tabs">
          <span class="nvim-tab nvim-tab--active" title={filePath}>
            <svg class="nvim-tab-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span class="nvim-tab-name">{filePath}</span>
            <span class="nvim-tab-ro" aria-label="Solo lectura">[RO]</span>
          </span>
        </div>
        <div class="nvim-tabline-right">
          {draft && (
            <span class="nvim-badge nvim-badge--draft">DRAFT</span>
          )}
          <span class="nvim-badge nvim-badge--read" aria-label={`Tiempo de lectura estimado: ${minutes} minutos`}>
            {minutes} min read
          </span>
          {tags.map((tag) => (
            <span class="nvim-badge nvim-badge--tag">#{tag}</span>
          ))}
        </div>
      </div>
    </aside>

    <main id="main-content">
      <!-- Hero del post -->
      <section class="post-hero">
        <div class="post-hero-scanlines" aria-hidden="true"></div>
        {heroImage && (
          <div class="post-hero-image">
            <img
              src={heroImage}
              alt={title}
              width={1200}
              height={630}
              loading="eager"
              decoding="async"
            />
            <div class="post-hero-image-overlay" aria-hidden="true"></div>
          </div>
        )}

        <div class="post-hero-content">
          <div class="post-hero-meta">
            <nav class="post-breadcrumb" aria-label="Miga de pan">
              <a href="/blog" class="breadcrumb-link">blog</a>
              <span class="breadcrumb-sep" aria-hidden="true">/</span>
              <span class="breadcrumb-current" aria-current="page">{postSlug}</span>
            </nav>
          </div>

          <h1 class="post-title">
            <span class="post-title-prompt" aria-hidden="true">$</span>
            {title}
          </h1>

          <p class="post-description">{description}</p>

          <div class="post-info-bar">
            <time class="info-item" datetime={isoDate}>
              <span class="info-key" aria-hidden="true">published</span>
              <span class="info-sep" aria-hidden="true">:</span>
              <span class="info-value">{formattedDate}</span>
            </time>

            <span class="info-divider" aria-hidden="true">|</span>

            <span class="info-item">
              <span class="info-key" aria-hidden="true">reading_time</span>
              <span class="info-sep" aria-hidden="true">:</span>
              <span class="info-value">{minutes} min</span>
            </span>

            {updatedDate && (
              <>
                <span class="info-divider" aria-hidden="true">|</span>
                <time class="info-item" datetime={isoUpdated}>
                  <span class="info-key" aria-hidden="true">updated</span>
                  <span class="info-sep" aria-hidden="true">:</span>
                  <span class="info-value">
                    {updatedDate.toLocaleDateString("es-CO", { year: "numeric", month: "short", day: "numeric" })}
                  </span>
                </time>
              </>
            )}
          </div>
        </div>
      </section>

      <!-- Layout con Article + Outline (TOC) -->
      <div class="post-container">
        <div class="post-grid">
          <article class="post-article" id="postArticle">
            <div class="prose">
              <slot />
            </div>

            <!-- Footer del artículo -->
            <footer class="article-footer">
              <div class="footer-divider" aria-hidden="true">
                <span class="footer-divider-line"></span>
                <span class="footer-divider-label">EOF // FIN DEL ARCHIVO</span>
                <span class="footer-divider-line"></span>
              </div>

              {tags.length > 0 && (
                <div class="footer-tags">
                  <span class="footer-tags-label" aria-hidden="true">topics:</span>
                  <div class="footer-tags-list" role="list" aria-label="Etiquetas del artículo">
                    {tags.map((tag) => (
                      <a href={`/blog?tag=${encodeURIComponent(tag)}`} class="footer-tag" role="listitem">
                        #{tag}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <!-- Actions bar: compartir & volver -->
              <div class="article-actions">
                <a href="/blog" class="back-link">
                  <span class="back-link-prompt" aria-hidden="true">&lt;</span>
                  cd ../blog
                </a>

                <button type="button" class="share-btn" id="shareBtn" aria-label="Copiar enlace del artículo">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
                  </svg>
                  <span class="share-btn-text">Copiar enlace</span>
                </button>
              </div>

              <!-- Next / Previous post navigation -->
              {(prevPost || nextPost) && (
                <nav class="post-pagination" aria-label="Navegación entre artículos">
                  {prevPost ? (
                    <a href={`/blog/${prevPost.id}`} class="pagination-card pagination-prev">
                      <span class="pagination-meta">
                        <span class="pagination-arrow" aria-hidden="true">&larr;</span> Anterior
                      </span>
                      <span class="pagination-title">{prevPost.title}</span>
                    </a>
                  ) : (
                    <div class="pagination-placeholder"></div>
                  )}

                  {nextPost ? (
                    <a href={`/blog/${nextPost.id}`} class="pagination-card pagination-next">
                      <span class="pagination-meta">
                        Siguiente <span class="pagination-arrow" aria-hidden="true">&rarr;</span>
                      </span>
                      <span class="pagination-title">{nextPost.title}</span>
                    </a>
                  ) : (
                    <div class="pagination-placeholder"></div>
                  )}
                </nav>
              )}
            </footer>
          </article>

          <!-- Table of contents / Document outline (Desktop sticky) -->
          {tocHeadings.length > 1 && (
            <aside class="post-toc-sidebar" aria-label="Tabla de contenidos">
              <div class="toc-card">
                <div class="toc-header">
                  <span class="toc-icon" aria-hidden="true">#</span>
                  <span class="toc-title">outline.symbols</span>
                </div>
                <nav class="toc-nav">
                  <ul class="toc-list">
                    {tocHeadings.map((h) => (
                      <li class:list={["toc-item", `toc-depth-${h.depth}`]}>
                        <a href={`#${h.slug}`} class="toc-link" data-slug={h.slug}>
                          <span class="toc-prefix" aria-hidden="true">
                            {h.depth === 2 ? "##" : "###"}
                          </span>
                          <span class="toc-text">{h.text}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
                <div class="toc-footer">
                  <a href="#main-content" class="toc-top-link">
                    <span aria-hidden="true">&uarr;</span> Inicio del documento
                  </a>
                </div>
              </div>
            </aside>
          )}
        </div>
      </div>
    </main>

    <Footer />

    <!-- Toast de copiado -->
    <div id="copyToast" class="copy-toast" role="status" aria-live="polite" aria-hidden="true">
      Enlace copiado al portapapeles
    </div>
  </body>
</html>

<style is:global>
  /* ─── Prose Typography (Catppuccin Noir & Latte) ───────────── */

  .prose {
    color: var(--subtext1);
    font-size: 1.0625rem;
    line-height: 1.85;
    max-width: 70ch;
  }

  .prose > * + * {
    margin-top: 1.5em;
  }

  .prose p {
    margin: 0 0 1.4em;
    color: var(--subtext1);
  }

  .prose h2 {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 700;
    color: var(--mauve);
    margin: 2.5em 0 0.75em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(var(--mauve-rgb), 0.2);
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    scroll-margin-top: 110px;
  }

  .prose h2::before {
    content: "##";
    color: var(--overlay1);
    font-size: 0.85em;
    font-weight: 400;
    flex-shrink: 0;
  }

  .prose h3 {
    font-family: var(--font-mono);
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    font-weight: 700;
    color: var(--sky);
    margin: 2em 0 0.6em;
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    scroll-margin-top: 110px;
  }

  .prose h3::before {
    content: "###";
    color: var(--overlay1);
    font-size: 0.85em;
    font-weight: 400;
    flex-shrink: 0;
  }

  .prose h4 {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--teal);
    margin: 1.75em 0 0.5em;
    scroll-margin-top: 110px;
  }

  .prose h4::before {
    content: "#### ";
    color: var(--overlay1);
    font-weight: 400;
  }

  .prose strong {
    color: var(--text);
    font-weight: 700;
  }

  .prose em {
    color: var(--flamingo);
    font-style: italic;
  }

  .prose a {
    color: var(--sky);
    text-decoration: underline;
    text-decoration-color: rgba(var(--sky-rgb), 0.4);
    text-underline-offset: 3px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }

  .prose a:hover {
    color: var(--sapphire);
    text-decoration-color: var(--sapphire);
  }

  .prose ul {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5em;
  }

  .prose ul > li {
    position: relative;
    padding-left: 1.5em;
    margin-bottom: 0.6em;
    color: var(--subtext1);
    line-height: 1.75;
  }

  .prose ul > li::before {
    content: "▸";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--mauve);
    font-size: 0.85em;
    font-family: var(--font-mono);
    line-height: inherit;
  }

  .prose ol {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5em;
    counter-reset: prose-ol;
  }

  .prose ol > li {
    counter-increment: prose-ol;
    position: relative;
    padding-left: 2em;
    margin-bottom: 0.6em;
    color: var(--subtext1);
    line-height: 1.75;
  }

  .prose ol > li::before {
    content: counter(prose-ol, decimal-leading-zero) ".";
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-mono);
    font-size: 0.85em;
    font-variant-numeric: tabular-nums;
    color: var(--peach);
    line-height: inherit;
  }

  .prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--peach);
    background: rgba(var(--surface0-rgb), 0.8);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    word-break: break-word;
  }

  /* Code Block Wrapper with copy button */
  .code-block-wrapper {
    position: relative;
    margin: 1.5em 0;
  }

  .prose pre {
    background: var(--mantle);
    border: 1px solid rgba(var(--overlay0-rgb), 0.25);
    border-left: 3px solid var(--mauve);
    border-radius: 0 8px 8px 0;
    padding: 1.25em 1.5em;
    overflow-x: auto;
    margin: 0;
    position: relative;
  }

  .code-copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    background: rgba(var(--crust-rgb), 0.85);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--subtext0);
    cursor: pointer;
    transition: transform 140ms var(--ease-out), color 140ms var(--ease-out), border-color 140ms var(--ease-out), background 140ms var(--ease-out), opacity 140ms var(--ease-out);
    z-index: 5;
    opacity: 0.6;
  }

  .code-copy-btn:active {
    transform: scale(0.92);
  }

  @media (hover: hover) and (pointer: fine) {
    .code-block-wrapper:hover .code-copy-btn,
    .code-copy-btn:focus-visible {
      opacity: 1;
    }

    .code-copy-btn:hover {
      color: var(--mauve);
      border-color: rgba(var(--mauve-rgb), 0.5);
      background: rgba(var(--surface0-rgb), 0.95);
    }
  }

  .code-copy-btn.copied {
    color: var(--green);
    border-color: rgba(var(--green-rgb), 0.5);
    opacity: 1;
    animation: popIn 180ms var(--ease-out);
  }

  @keyframes popIn {
    0% {
      transform: scale(0.94);
    }
    100% {
      transform: scale(1);
    }
  }

  .prose pre > code {
    all: unset;
    font-family: var(--font-mono);
    font-size: 0.875em;
    line-height: 1.65;
    color: var(--text);
    display: block;
    tab-size: 2;
  }

  .prose blockquote {
    border-left: 3px solid var(--yellow);
    background: rgba(var(--surface0-rgb), 0.4);
    padding: 0.75em 1.25em;
    border-radius: 0 6px 6px 0;
    margin: 1.5em 0;
    font-style: normal;
    color: var(--subtext0);
  }

  .prose blockquote::before {
    content: "// NOTE";
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--yellow);
    font-style: normal;
    margin-bottom: 0.4em;
    letter-spacing: 0.05em;
  }

  .prose hr {
    border: none;
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.3);
    margin: 2.5em 0;
    position: relative;
  }

  .prose hr::after {
    content: "···";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    background: var(--base);
    padding: 0 0.75em;
    color: var(--overlay0);
    font-family: var(--font-mono);
    letter-spacing: 0.3em;
    font-size: 0.8em;
  }

  /* Responsive table wrapper */
  .table-responsive-wrapper {
    width: 100%;
    overflow-x: auto;
    margin: 1.5em 0;
    border: 1px solid rgba(var(--overlay0-rgb), 0.15);
    border-radius: 6px;
    background: var(--surface0);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9em;
    margin: 0;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .prose table th {
    background: rgba(var(--mauve-rgb), 0.1);
    color: var(--mauve);
    font-weight: 700;
    text-align: left;
    padding: 0.75em 1em;
    border-bottom: 1px solid rgba(var(--mauve-rgb), 0.3);
    font-size: 0.85em;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .prose table td {
    padding: 0.65em 1em;
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.15);
    color: var(--subtext0);
    white-space: nowrap;
  }

  .prose table tr:last-child td {
    border-bottom: none;
  }

  /* Latte theme overrides */
  html[data-theme="latte"] .prose blockquote {
    background: rgba(var(--surface0-rgb), 0.6);
  }

  html[data-theme="latte"] .prose pre {
    background: var(--mantle);
  }
</style>

<style>
  /* ─── Reading Progress Bar ─────────────────────────────────── */

  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2.5px;
    width: 0%;
    background: linear-gradient(90deg, var(--sky) 0%, var(--mauve) 100%);
    box-shadow: 0 0 8px rgba(var(--mauve-rgb), 0.5);
    transition: width 100ms linear;
    z-index: 999;
    pointer-events: none;
  }

  /* ─── Neovim Tabline (Document buffer header) ──────────────── */

  .nvim-tabline {
    background: var(--crust);
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.16);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    position: relative;
    z-index: 10;
  }

  .nvim-tabline-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 12px;
    min-height: 36px;
  }

  .nvim-tabs {
    display: flex;
    align-items: stretch;
    gap: 0;
    overflow: hidden;
  }

  .nvim-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 16px;
    color: var(--subtext0);
    font-size: 0.75rem;
    border-right: 1px solid rgba(var(--overlay0-rgb), 0.15);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 440px;
  }

  .nvim-tab--active {
    background: var(--base);
    color: var(--text);
    border-top: 2px solid var(--mauve);
  }

  .nvim-tab-icon {
    color: var(--mauve);
    flex-shrink: 0;
  }

  .nvim-tab-name {
    color: var(--text);
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nvim-tab-ro {
    color: var(--overlay1);
    font-size: 0.7rem;
    margin-left: 2px;
  }

  .nvim-tabline-right {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    flex-wrap: wrap;
  }

  .nvim-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 3px;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .nvim-badge--draft {
    background: rgba(var(--yellow-rgb), 0.12);
    color: var(--yellow);
    border: 1px solid rgba(var(--yellow-rgb), 0.3);
  }

  .nvim-badge--read {
    background: rgba(var(--mauve-rgb), 0.08);
    color: var(--mauve);
    border: 1px solid rgba(var(--mauve-rgb), 0.2);
    font-variant-numeric: tabular-nums;
  }

  .nvim-badge--tag {
    background: rgba(var(--sky-rgb), 0.08);
    color: var(--sky);
    border: 1px solid rgba(var(--sky-rgb), 0.2);
  }

  /* ─── Post Hero ────────────────────────────────────────────── */

  .post-hero {
    background: linear-gradient(180deg, var(--crust) 0%, var(--base) 100%);
    padding: 48px 24px 44px;
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.12);
  }

  .post-hero-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(var(--overlay0-rgb), 0.03) 2px,
      rgba(var(--overlay0-rgb), 0.03) 4px
    );
    pointer-events: none;
  }

  .post-hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .post-hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.12;
    filter: grayscale(40%);
  }

  .post-hero-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(var(--crust-rgb), 0.7) 0%,
