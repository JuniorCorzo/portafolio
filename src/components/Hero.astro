---
import { Image } from "astro:assets";
import {
  DEVELOPER_NAME,
  HERO_CHIPS,
  HERO_HEADLINE_1,
  HERO_HEADLINE_2,
  HERO_IMAGE,
  HERO_DESCRIPTION,
} from "../consts";
import {
  WHATSAPP_NUMBER,
  WHATSAPP_MESSAGE,
} from "../data/contact";

const waUrl = WHATSAPP_NUMBER
  ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`
  : "/contacto";
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-chips">
      {HERO_CHIPS.map(({ title, color, background }) => (
        <span
          class="chip"
          style={`color: var(${color}); background: rgba(var(${background}), 0.08); border-color: var(${color});`}
        >
          <span class="chip-dot">●</span>
          {title}
        </span>
      ))}
    </div>

    <div class="hero-body">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="headline-primary">{HERO_HEADLINE_1}</span>
          <span class="headline-accent">{HERO_HEADLINE_2}</span>
        </h1>

        <p class="hero-subtitle">Hola, soy {DEVELOPER_NAME}</p>
        <p class="hero-description">{HERO_DESCRIPTION}</p>

        <div class="hero-cta">
          <a
            href={waUrl}
            class="cta-button cta-primary"
            target={waUrl === "/contacto" ? undefined : "_blank"}
            rel={waUrl === "/contacto" ? undefined : "noopener noreferrer"}
          >
            💬 Hablemos por WhatsApp
          </a>
          <a href="/servicios" class="cta-button cta-secondary">Ver servicios →</a>
        </div>
      </div>

      <div class="hero-image-container">
        <div class="hero-image-frame">
          <Image
            src={HERO_IMAGE}
            class="hero-image"
            alt="Angel Corzo - Desarrollador Full Stack en Cúcuta"
            loading="eager"
            fetchpriority="high"
            width={480}
            height={600}
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 48px 24px 80px;
    background: linear-gradient(135deg, var(--crust) 0%, var(--base) 100%);
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(203, 166, 247, 0.08) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 24px;
    gap: 10px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 16px;
    border-radius: 9999px;
    border: 1px solid;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }

  .chip-dot {
    font-size: 0.8rem;
    line-height: 1;
  }

  .hero-body {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: 48px;
    align-items: center;
  }

  .hero-title {
    margin: 0;
    line-height: 1.05;
    max-width: none;
    width: 100%;
  }

  .headline-primary,
  .headline-accent {
    display: block;
    font-size: clamp(2.1rem, 5vw, 3.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .headline-primary {
    color: var(--text);
  }

  .headline-accent {
    color: var(--sky);
  }

  .hero-subtitle {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 12px;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--subtext0);
    margin-top: 20px;
    line-height: 1.8;
    max-width: none;
    width: 100%;
    text-wrap: pretty;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 32px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    border: 2px solid;
  }

  .cta-primary {
    background: #25d366;
    color: #1e1e2e;
    border-color: #25d366;
  }

  .cta-primary:hover {
    background: #128c7e;
    border-color: #128c7e;
    transform: translateY(-2px);
    box-shadow: 0 3px 10px rgba(37, 211, 102, 0.3);
    color: #1e1e2e;
  }

  .cta-secondary {
    background: transparent;
    color: var(--mauve);
    border-color: var(--mauve);
  }

  .cta-secondary:hover {
    background: var(--mauve);
    color: var(--crust);
    transform: translateY(-2px);
  }

  .hero-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image-frame {
    width: 100%;
    max-width: 400px;
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    border: 1px solid var(--mauve);
    box-shadow: 0 0 20px rgba(203, 166, 247, 0.2);
    overflow: hidden;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1024px) {
    .hero-body {
      grid-template-columns: 1fr;
    }

    .hero-image-container {
      order: -1;
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 40px 24px 64px;
    }
  }

  @media (max-width: 640px) {
    .hero-chips {
      gap: 8px;
    }

    .chip {
      width: 100%;
      justify-content: center;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .hero-cta {
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>
