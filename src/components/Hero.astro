---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { DEVELOPER_NAME, HERO_CHIPS } from "../consts";

import {
  HERO_HEADLINE_1,
  HERO_HEADLINE_2,
  HERO_IMAGE,
  HERO_DESCRIPTION,
} from "../consts";
import Chip from "./Chip.astro";
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-header">
      {
        HERO_CHIPS.map(({ title, icon, color, background }) => (
          <Chip
            title={title}
            icon={icon}
            class="hero-chip"
            style={{
              color: `var(${color})`,
              backgroundColor: `rgba(var(${background}), 0.1)`,
              borderColor: `var(${color})`,
            }}
          />
        ))
      }
    </div>
    <div class="hero-body">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="headline-primary"
            >{HERO_HEADLINE_1}
            <span style="color: var(--sky);">{`[${DEVELOPER_NAME}]`}</span>
          </span>
        </h1>
        <h2 class="headline-accent">{HERO_HEADLINE_2}</h2>
        <p class="hero-description">{HERO_DESCRIPTION}</p>
        <div class="hero-cta">
          <a href="#projects" class="cta-button cta-primary">
            Proyectos
            <Icon name="heroicons:arrow-long-right" size={20} />
          </a>
          <a href="#contact" class="cta-button cta-secondary">
            Contactar
            <Icon name="lucide:send-horizontal" size={20} />
          </a>
        </div>
      </div>
      <div class="hero-image-container">
        <Image
          src={HERO_IMAGE}
          class="hero-image"
          alt="Hero Image"
          loading="eager"
          fetchpriority="high"
          width={480}
          height={600}
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 3rem 24px;
    background: linear-gradient(135deg, var(--crust) 0%, var(--base) 100%);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    top: -50%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(183, 50, 63, 0.1) 0%,
      transparent 70%
    );
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-container {
    width: 100%;
    position: relative;
    z-index: 1;
  }

  .hero-body {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    box-sizing: border-box;
  }

  .hero-content {
    text-align: left;
    grid-column: span 7;
    padding-right: 1.8rem;
  }

  .hero-title {
    margin: 0 0 24px 0;
    line-height: 1.1;
  }

  .headline-primary {
    display: block;
    color: var(--text);
    font-size: 4.5rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .headline-accent {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 2rem;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--subtext);
    margin-top: 1rem;
    line-height: 1.8;
    text-wrap: pretty;
  }

  .hero-image-container {
    position: relative;
    grid-column: span 5;
  }

  .hero-image {
    aspect-ratio: 4 / 5;
    max-width: 460px;
    width: 100%;
    object-fit: cover;
    border: 1px solid var(--accent);
    box-shadow: 0 0 20px var(--accent-dark);
    margin: 0 auto;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    justify-content: start;
    flex-wrap: wrap;
  }

  .hero-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 2em;
    gap: 12px;
  }

  .hero-chip {
    backdrop-filter: blur(8px);
    font-weight: 600;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 32px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    cursor: pointer;
  }

  .cta-primary {
    background-color: var(--accent);
    color: #1e1e2e;
    border: 2px solid var(--accent);
    font-weight: 700;
  }

  .cta-primary:hover {
    background-color: var(--accent-dark);
    border-color: var(--accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 3px 10px rgba(var(--sky-rgb), 0.2);

    & svg {
      transform: translateX(4px);
      transition: all 0.3s ease-in-out;
    }
  }

  .cta-secondary {
    background-color: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
  }

  .cta-secondary:hover {
    background-color: var(--accent);
    color: #1e1e2e;
    font-weight: 700;
    transform: translateY(-2px);
    box-shadow: 0 3px 10px rgba(var(--sky-rgb), 0.2);

    & svg {
      transform: rotate(-25deg);
      transition: all 0.3s ease-in-out;
    }
  }

  @media (max-width: 1024px) {
    .hero-section {
      padding: 2rem 24px;
    }

    .hero-body {
      display: flex;
      flex-direction: column-reverse;
      gap: 2rem;
    }

    .headline-primary {
      font-size: 3rem;
    }

    .headline-accent {
      font-size: 1.5rem;
    }

    .hero-subtitle {
      font-size: 1rem;
    }

    .hero-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .hero-content {
      padding-right: 0;
    }

    .hero-image {
      max-width: 90vw;
      aspect-ratio: 1/1;
      object-position: top;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 1.5rem 16px;
    }

    .headline-primary {
      font-size: 2.25rem;
    }

    .headline-accent {
      font-size: 1.25rem;
    }

    .hero-subtitle {
      font-size: 0.95rem;
      margin-bottom: 32px;
    }

    .hero-cta {
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
    }
  }
</style>
