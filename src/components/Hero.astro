---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import {
  DEVELOPER_NAME,
  HERO_CHIPS,
  HERO_HEADLINE_1,
  HERO_HEADLINE_2,
  HERO_IMAGE,
  HERO_DESCRIPTION,
} from "../consts";
import {
  WHATSAPP_NUMBER,
  WHATSAPP_MESSAGE,
} from "../data/contact";

const waUrl = WHATSAPP_NUMBER
  ? `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`
  : "/contacto";
---

<section class="hero-section">
  <div class="hero-container">
    <div class="hero-chips">
      {HERO_CHIPS.map(({ title, color, background, icon }, index) => (
        <span
          class={`chip ${index === 0 ? "chip-status" : "chip-desktop-only"}`}
          style={`color: var(${color}); border: 1px solid; border-color: rgba(var(${background}), 0.35); background: rgba(var(${background}), 0.06);`}
        >
          {icon ? <Icon name={icon} size={14} class="chip-icon" /> : <span class="chip-dot">●</span>}
          {title}
        </span>
      ))}
    </div>

    <div class="hero-body">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="headline-primary">{HERO_HEADLINE_1}</span>
          <span class="headline-accent">{HERO_HEADLINE_2}</span>
        </h1>

        <div class="hero-greeting-group">
          <button
            type="button"
            id="heroAvatarBtn"
            class="hero-avatar-btn"
            aria-label="Ver foto de perfil de Angel Corzo ampliada"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="heroImageContainer"
          >
            <span class="hero-avatar-wrapper">
              <Image
                src={HERO_IMAGE}
                class="hero-avatar-img"
                alt="Angel Corzo - Foto de perfil"
                loading="eager"
                width={72}
                height={72}
              />
              <span class="avatar-expand-icon-wrap" aria-hidden="true">
                <Icon name="lucide:maximize-2" size={12} class="avatar-expand-icon" />
              </span>
            </span>
          </button>
          <p class="hero-subtitle">Hola, soy {DEVELOPER_NAME}</p>
        </div>

        <p class="hero-description">{HERO_DESCRIPTION}</p>

        <div class="hero-cta">
          <a
            href={waUrl}
            class="cta-button cta-primary"
            target={waUrl === "/contacto" ? undefined : "_blank"}
            rel={waUrl === "/contacto" ? undefined : "noopener noreferrer"}
          >
            <Icon name="lucide:message-circle" size={18} class="cta-icon" /> Hablemos por WhatsApp
          </a>
          <a href="/servicios" class="cta-button cta-secondary">Ver servicios →</a>
        </div>
      </div>

      <div
        class="hero-image-container"
        id="heroImageContainer"
        role="region"
        aria-label="Foto de perfil de Angel Corzo ampliada"
      >
        <div class="photo-pane-wrap">
          <button
            type="button"
            id="heroModalClose"
            class="hero-modal-close"
            aria-label="Cerrar vista ampliada"
          >
            <Icon name="lucide:x" size={20} />
          </button>

          <div class="photo-top-hud">
            <span class="hud-filename">BUFFER: img/angel_corzo.webp</span>
            <span class="hud-status-badge">[CALIBRATED · 380x350]</span>
          </div>

          <div class="photo-img-container">
            <Image
              src={HERO_IMAGE}
              class="hero-image"
              alt="Angel Corzo - Desarrollador Full Stack en Cúcuta"
              loading="eager"
              fetchpriority="high"
              width={480}
              height={600}
            />
            <div class="photo-hud-bottom">
              <div>
                <div class="hud-badge-lg">[FULL-STACK DEV]</div>
                <div class="hud-location">
                  <Icon name="lucide:map-pin" size={13} class="hud-location-icon" /> Cúcuta, Colombia
                </div>
              </div>
              <div class="hud-ok-badge">
                STATUS: 200 OK
              </div>
            </div>
          </div>

          <div class="photo-meta-bottom">
            <span>WEBP LOSSLESS</span>
            <span>AUTO-RESPONSIVE</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 48px 24px 72px;
    background: var(--crust);
    position: relative;
    overflow: hidden;
  }

  .hero-section::before {
    content: "";
    position: absolute;
    top: -40%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(var(--mauve-rgb), 0.07) 0%, transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 24px;
    gap: 10px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 14px;
    border-radius: 9999px;
    border: 1px solid;
    font-size: 0.75rem;
    font-weight: 600;
    font-family: var(--font-mono);
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }

  .chip:hover {
    box-shadow: 0 0 10px currentColor;
  }

  .chip-dot {
    font-size: 0.8rem;
    line-height: 1;
  }

  .hero-body {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: center;
  }

  .hero-title {
    margin: 0;
    line-height: 1.15;
    max-width: none;
    width: 100%;
  }

  .headline-primary,
  .headline-accent {
    display: block;
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.025em;
  }

  .headline-primary {
    color: var(--text);
  }

  .headline-accent {
    color: var(--mauve);
  }

  .hero-subtitle {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--subtext1);
    margin-top: 14px;
    margin-bottom: 0;
    font-family: var(--font-mono);
  }

  :global(html[data-theme="latte"]) .hero-subtitle {
    color: var(--text);
  }

  .hero-description {
    font-size: 1.05rem;
    color: var(--subtext0);
    margin-top: 18px;
    margin-bottom: 0;
    line-height: 1.7;
    max-width: 640px;
    text-wrap: pretty;
  }

  .hero-cta {
    display: flex;
    gap: 14px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 28px;
    min-height: 44px;
    border-radius: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.25s ease-in-out;
    border: 2px solid;
    font-family: var(--font-mono);
  }

  .cta-primary {
    background: #25d366;
    color: #000000;
    border-color: #25d366;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.25);
  }

  .cta-primary:hover {
    background: #1fa855;
    border-color: #1fa855;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(37, 211, 102, 0.35);
    color: #000000;
  }

  .cta-secondary {
    background: transparent;
    color: var(--mauve);
    border-color: var(--mauve);
  }

  .cta-secondary:hover {
    background: var(--mauve);
    color: var(--crust);
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(var(--mauve-rgb), 0.25);
  }

  .hero-image-container {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .photo-pane-wrap {
    width: 100%;
    max-width: 380px;
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;
    position: relative;
  }

  .hero-greeting-group {
    display: contents;
  }

  .hero-avatar-btn,
  #heroAvatarBtn {
    display: none;
  }

  .hero-modal-close,
  #heroModalClose {
    display: none;
  }

  .photo-pane-wrap:hover {
    border-color: var(--mauve);
    box-shadow: 0 0 25px rgba(var(--mauve-rgb), 0.2);
  }

  .photo-top-hud {
    background: var(--mantle);
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.3);
    padding: 7px 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.72rem;
    font-family: var(--font-mono);
    color: var(--subtext1);
  }

  .hud-status-badge {
    color: var(--green);
    font-weight: 700;
  }

  :global(html[data-theme="latte"]) .hud-status-badge {
    color: var(--text);
  }

  .photo-img-container {
    position: relative;
    background: #000000;
    height: 350px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    display: block;
    filter: contrast(1.03) brightness(0.99);
    transition: transform 0.35s ease;
  }

  .photo-pane-wrap:hover .hero-image {
    transform: scale(1.025);
  }

  .photo-hud-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.9) 0%, rgba(0, 0, 0, 0.5) 60%, transparent 100%);
    padding: 10px 14px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-family: var(--font-mono);
  }

  .hud-badge-lg {
    font-size: 0.72rem;
    background: rgba(0, 0, 0, 0.85);
    border: 1px solid rgba(203, 166, 247, 0.4);
    color: #cba6f7;
    padding: 2px 7px;
    border-radius: 4px;
    font-weight: 700;
    display: inline-block;
  }

  .hud-location {
    font-size: 0.75rem;
    color: #bac2de;
    margin-top: 3px;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .hud-location-icon {
    color: var(--teal);
    flex-shrink: 0;
  }

  .chip-icon,
  .cta-icon {
    flex-shrink: 0;
  }

  .hud-ok-badge {
    font-size: 0.72rem;
    color: var(--green);
    font-weight: 700;
  }

  .photo-meta-bottom {
    background: var(--mantle);
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.3);
    padding: 6px 12px;
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    color: var(--subtext1);
  }

  @media (max-width: 1024px) {
    .hero-body {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .hero-greeting-group {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-top: 18px;
    }

    .hero-greeting-group .hero-subtitle {
      margin-top: 0;
    }

    .hero-avatar-btn,
    #heroAvatarBtn {
      display: inline-flex;
      position: relative;
      cursor: pointer;
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      flex-shrink: 0;
      border-radius: 50%;
      outline: none;
      transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-avatar-btn:hover {
      transform: scale(1.04);
    }

    .hero-avatar-btn:focus-visible {
      outline: 2px solid var(--mauve);
      outline-offset: 3px;
    }

    .hero-avatar-wrapper {
      position: relative;
      width: 72px;
      height: 72px;
      display: block;
      border-radius: 50%;
    }

    .hero-avatar-img {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      border: 2px solid var(--mauve);
      object-fit: cover;
      object-position: center 18%;
      display: block;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);
      background: var(--surface0);
    }

    .avatar-expand-icon-wrap {
      position: absolute;
      bottom: 0;
      right: 0;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--surface0);
      border: 1.5px solid var(--mauve);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--mauve);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
      transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
    }

    .hero-avatar-btn:hover .avatar-expand-icon-wrap {
      background: var(--mauve);
      color: var(--crust);
      transform: scale(1.1);
    }

    .hero-image-container,
    #heroImageContainer {
      position: fixed;
      inset: 0;
      z-index: 100;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      margin: 0;
      max-width: none;
    }

    .hero-image-container.open,
    #heroImageContainer.open {
      display: flex;
      animation: heroModalFadeIn 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-image-container.open .photo-pane-wrap {
      animation: heroModalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .hero-modal-close,
    #heroModalClose {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: absolute;
      top: 6px;
      right: 8px;
      z-index: 20;
      width: 32px;
      height: 32px;
      border-radius: 6px;
      background: rgba(var(--mantle-rgb, 24, 24, 38), 0.8);
      border: 1px solid rgba(var(--mauve-rgb), 0.4);
      color: var(--text);
      cursor: pointer;
      transition: all 0.2s ease;
      padding: 0;
    }

    .hero-modal-close:hover {
      background: var(--mauve);
      color: var(--crust);
    }

    .hero-modal-close:focus-visible {
      outline: 2px solid var(--mauve);
      outline-offset: 2px;
    }

    .photo-top-hud {
      padding-right: 48px;
    }
  }

  @keyframes heroModalFadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes heroModalPop {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 36px 20px 56px;
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding: 32px 16px 48px;
    }

    .hero-chips {
      gap: 8px;
      margin-bottom: 16px;
    }

    .chip-desktop-only {
      display: none !important;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-cta {
      flex-direction: column;
    }

    .cta-button {
      width: 100%;
    }

    .photo-img-container {
      height: 320px;
    }
  }
</style>

<script>
  function setupHeroAvatarModal() {
    const avatarBtn = document.getElementById("heroAvatarBtn") as HTMLButtonElement | null;
    const container = document.getElementById("heroImageContainer");
    const closeBtn = document.getElementById("heroModalClose") as HTMLButtonElement | null;
    const paneWrap = container?.querySelector(".photo-pane-wrap");

    if (!avatarBtn || !container) return;
    const btn = avatarBtn;
    const modal = container;

    if (btn.dataset.modalBound === "true") return;
    btn.dataset.modalBound = "true";

    function openModal() {
      modal.classList.add("open");
      modal.setAttribute("role", "dialog");
      modal.setAttribute("aria-modal", "true");
      btn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn?.focus();
    }

    function closeModal() {
      if (!modal.classList.contains("open")) return;
      modal.classList.remove("open");
      modal.setAttribute("role", "region");
      modal.removeAttribute("aria-modal");
      btn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      btn.focus();
    }

    btn.addEventListener("click", openModal);
    closeBtn?.addEventListener("click", closeModal);

    modal.addEventListener("click", (e) => {
      if (e.target instanceof Node && paneWrap && !paneWrap.contains(e.target)) {
        closeModal();
      }
    });

    window.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("open")) {
        closeModal();
      }
    });

    const mql = window.matchMedia("(min-width: 1024px)");
    mql.addEventListener("change", (e) => {
      if (e.matches && modal.classList.contains("open")) {
        closeModal();
      }
    });
  }

  setupHeroAvatarModal();
  document.addEventListener("astro:after-swap", setupHeroAvatarModal);
</script>
