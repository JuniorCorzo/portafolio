---
interface Props {
  size?: number;
  class?: string;
  framed?: boolean;
}

const { size = 24, class: className = "", framed = false } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  fill="none"
  class:list={["brand-mark", className]}
  aria-hidden="true"
>
  {framed ? (
    <>
      <rect
        x="1"
        y="1"
        width="62"
        height="62"
        rx="14"
        fill="var(--surface0)"
        stroke="rgba(var(--overlay0-rgb), 0.35)"
        stroke-width="2"
      />
      <path
        d="M16 47L30.2 15.5C30.9 14 33.1 14 33.8 15.5L48 47"
        stroke="currentColor"
        stroke-width="5.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <rect
        class="brand-cursor"
        x="25"
        y="42.5"
        width="14"
        height="5"
        rx="2.5"
        fill="var(--mauve)"
      />
    </>
  ) : (
    <>
      <path
        d="M12 50L29.8 12.5C30.7 10.6 33.3 10.6 34.2 12.5L52 50"
        stroke="currentColor"
        stroke-width="6.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <rect
        class="brand-cursor"
        x="23"
        y="44"
        width="18"
        height="6"
        rx="3"
        fill="var(--mauve)"
      />
    </>
  )}
</svg>

<style>
  .brand-mark {
    display: inline-block;
    flex-shrink: 0;
  }
</style>
