---
import { Icon } from "astro-icon/components";
import { DEVELOPER_CV } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => {
  const cleanPath = path.replace(/\/$/, "");
  if (cleanPath === "") return currentPath === "";
  return currentPath.startsWith(cleanPath);
};
---

<header class="header">
  <nav class="navbar">
    <div class="logo">
      <a href="/">
        <span class="prompt">&gt;_</span>
        <span class="monogram">AC</span>
        <span class="brand">angelcorzo</span>
      </a>
    </div>

    <div class="nav-links" id="navLinks">
      <a href="/" class:list={["nav-link", { active: isActive("/") }]}>Inicio</a>
      <a href="/servicios" class:list={["nav-link", { active: isActive("/servicios") }]}>Servicios</a>
      <a href="/sobre-mi" class:list={["nav-link", { active: isActive("/sobre-mi") }]}>Sobre mí</a>
      <a href="/blog" class:list={["nav-link", { active: isActive("/blog") }]}>Blog</a>
      <a href="/contacto" class:list={["nav-link", { active: isActive("/contacto") }]}>Contacto</a>

      <div class="mobile-cv">
        <a href={DEVELOPER_CV} target="_blank" rel="noreferrer" class="cv">
          <Icon name="lucide:download" size={20} />
          Descargar CV
        </a>
      </div>
    </div>

    <div class="desktop-actions">
      <ThemeToggle />
      <div class="desktop-cv">
        <a href={DEVELOPER_CV} target="_blank" rel="noreferrer" class="cv">
          <Icon name="lucide:download" size={20} />
          Descargar CV
        </a>
      </div>
    </div>

    <div class="mobile-actions">
      <ThemeToggle />
      <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-label="Abrir menú">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(var(--crust-rgb), 0.96);
    backdrop-filter: blur(5px);
    border-bottom: 1px solid rgba(108, 112, 134, 0.2);
  }

  .navbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .logo {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .logo a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.3s ease-in-out;
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .logo a:hover {
    color: var(--mauve);
  }

  .logo .prompt {
    color: var(--mauve);
    font-weight: 700;
  }

  .logo .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--mauve-rgb), 0.15);
    color: var(--mauve);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.8em;
    font-weight: 800;
    letter-spacing: 0.05em;
    border: 1px solid rgba(var(--mauve-rgb), 0.3);
  }

  .logo .brand {
    color: var(--text);
    font-weight: 700;
    transition: color 0.3s ease-in-out;
  }

  .logo a:hover .brand {
    color: var(--mauve);
  }

  .nav-links {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .nav-link {
    color: var(--subtext1);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s ease-in-out;
    position: relative;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--mauve);
    transition: width 0.3s ease-in-out;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }

  .cv {
    display: inline-flex;
    background-color: rgba(var(--mauve-rgb), 0.1);
    color: var(--mauve);
    align-items: center;
    border: 2px solid rgba(var(--mauve-rgb), 0.1);
    padding: 8px 14px;
    min-height: 44px;
    gap: 8px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    text-decoration: none;
  }

  .cv:hover {
    background-color: var(--mauve);
    color: var(--crust);
    border-color: var(--mauve);
    transform: translateY(-2px);
    box-shadow: 0 3px 10px rgba(var(--mauve-rgb), 0.5);
  }

  .mobile-cv {
    display: none;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .desktop-cv {
    display: inline-flex;
  }

  .mobile-actions {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
  }

  .bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    margin: 4px 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .navbar {
      padding: 0 20px;
      height: 60px;
    }

    .desktop-actions {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .desktop-cv {
      display: none;
    }

    .mobile-cv {
      display: flex;
      width: 100%;
    }

    .nav-links {
      background: rgba(var(--crust-rgb), 0.96);
      backdrop-filter: blur(5px);
      display: none;
      position: absolute;
      width: 100%;
      left: 0;
      transform: none;
      align-items: start;
      top: 60px;
      flex-direction: column;
      padding: 16px 20px;
      gap: 8px;
      border-radius: 0 0 8px 8px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
      z-index: 9999;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 10px 12px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      width: 100%;
    }

    .nav-link {
      font-size: 1rem;
      font-weight: 400;
    }

    .cv {
      width: 100%;
      justify-content: center;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .navbar {
      padding: 0 16px;
      height: 56px;
    }

    .logo {
      font-size: 1.1rem;
    }

    .nav-links {
      gap: 12px;
    }
  }
</style>

<script>
  const button = document.getElementById("menuToggle");
  const nav = document.getElementById("navLinks");

  if (button && nav) {
    button.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("open");
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("open")) {
        nav.classList.remove("open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú");
        button.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (
        nav.classList.contains("open") &&
        !nav.contains(e.target as Node) &&
        !button.contains(e.target as Node)
      ) {
        nav.classList.remove("open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú");
      }
    });
  }
</script>
