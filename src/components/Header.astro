---
import { Icon } from "astro-icon/components";
import { DEVELOPER_CV } from "../consts";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isActive = (path: string) => {
  const cleanPath = path.replace(/\/$/, "");
  if (cleanPath === "") return currentPath === "";
  return currentPath.startsWith(cleanPath);
};
---

<header class="header">
  <div class="header-titlebar">
    <div class="titlebar-container">
      <div class="titlebar-controls">
        <span class="control-dot dot-close" aria-hidden="true"></span>
        <span class="control-dot dot-minimize" aria-hidden="true"></span>
        <span class="control-dot dot-maximize" aria-hidden="true"></span>
        <span class="titlebar-session">angelcorzo.dev — tmux: portafolio</span>
      </div>
      <div class="titlebar-node">
        <span class="node-indicator" aria-hidden="true">●</span> NODE: CLOUDFLARE EDGE
      </div>
    </div>
  </div>

  <nav class="navbar">
    <div class="logo">
      <a href="/">
        <span class="prompt">&gt;_</span>
        <span class="monogram">AC</span>
        <span class="brand">angelcorzo</span>
      </a>
    </div>

    <div class="nav-links tmux-bar" id="navLinks">
      <a href="/" class:list={["nav-link tmux-tab", { active: isActive("/") }]}>
        <span class="tab-idx">1:</span>inicio.astro{isActive("/") ? "*" : ""}
      </a>
      <a href="/servicios" class:list={["nav-link tmux-tab", { active: isActive("/servicios") }]}>
        <span class="tab-idx">2:</span>servicios.astro{isActive("/servicios") ? "*" : ""}
      </a>
      <a href="/sobre-mi" class:list={["nav-link tmux-tab", { active: isActive("/sobre-mi") }]}>
        <span class="tab-idx">3:</span>sobre-mi.astro{isActive("/sobre-mi") ? "*" : ""}
      </a>
      <a href="/blog" class:list={["nav-link tmux-tab", { active: isActive("/blog") }]}>
        <span class="tab-idx">4:</span>blog.astro{isActive("/blog") ? "*" : ""}
      </a>
      <a href="/contacto" class:list={["nav-link tmux-tab", { active: isActive("/contacto") }]}>
        <span class="tab-idx">5:</span>contacto.sh{isActive("/contacto") ? "*" : ""}
      </a>

      <div class="mobile-cv">
        <a href={DEVELOPER_CV} target="_blank" rel="noreferrer" class="cv">
          <Icon name="lucide:download" size={20} />
          Descargar CV
        </a>
      </div>
    </div>

    <div class="desktop-actions">
      <ThemeToggle />
      <div class="desktop-cv">
        <a href={DEVELOPER_CV} target="_blank" rel="noreferrer" class="cv">
          <Icon name="lucide:download" size={20} />
          Descargar CV
        </a>
      </div>
    </div>

    <div class="mobile-actions">
      <ThemeToggle />
      <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-label="Abrir menú">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(var(--crust-rgb), 0.96);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(108, 112, 134, 0.2);
  }

  .header-titlebar {
    background: var(--crust);
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.16);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--subtext0);
  }

  .titlebar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 6px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .titlebar-controls {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .control-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-close {
    background: var(--red);
  }

  .dot-minimize {
    background: var(--yellow);
  }

  .dot-maximize {
    background: var(--green);
  }

  .titlebar-session {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--subtext0);
    margin-left: 6px;
    letter-spacing: 0.02em;
  }

  .titlebar-node {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--green);
    display: flex;
    align-items: center;
    gap: 6px;
    letter-spacing: 0.04em;
  }

  .node-indicator {
    color: var(--green);
    animation: pulse-node 2s infinite ease-in-out;
  }

  @keyframes pulse-node {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .navbar {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .logo {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .logo a {
    color: var(--text);
    text-decoration: none;
    transition: color 0.3s ease-in-out;
    font-family: var(--font-mono);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .logo a:hover {
    color: var(--mauve);
  }

  .logo .prompt {
    color: var(--mauve);
    font-weight: 700;
  }

  .logo .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--mauve-rgb), 0.15);
    color: var(--mauve);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 0.8em;
    font-weight: 800;
    letter-spacing: 0.05em;
    border: 1px solid rgba(var(--mauve-rgb), 0.3);
  }

  .logo .brand {
    color: var(--text);
    font-weight: 700;
    transition: color 0.3s ease-in-out;
  }

  .logo a:hover .brand {
    color: var(--mauve);
  }

  .tmux-bar {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .tmux-tab {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    padding: 6px 12px;
    border-radius: 5px;
    color: var(--subtext1);
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border: 1px solid transparent;
  }

  .tmux-tab .tab-idx {
    color: var(--overlay1);
    font-weight: 700;
  }

  .tmux-tab:hover {
    color: var(--text);
    background: rgba(var(--surface0-rgb), 0.5);
    border-color: rgba(var(--overlay0-rgb), 0.25);
  }

  .tmux-tab.active {
    color: var(--mauve);
    background: rgba(var(--surface0-rgb), 0.8);
    border-color: rgba(var(--mauve-rgb), 0.4);
    font-weight: 700;
  }

  .tmux-tab.active .tab-idx {
    color: var(--peach);
  }

  :global(html[data-theme="latte"]) .tmux-tab.active {
    color: #8839ef;
    background: #e6e9ef;
    border-color: rgba(136, 57, 239, 0.4);
  }

  .cv {
    display: inline-flex;
    background-color: rgba(var(--mauve-rgb), 0.1);
    color: var(--mauve);
    align-items: center;
    border: 2px solid rgba(var(--mauve-rgb), 0.1);
    padding: 8px 14px;
    min-height: 44px;
    gap: 8px;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    text-decoration: none;
  }

  .cv:hover {
    background-color: var(--mauve);
    color: var(--crust);
    border-color: var(--mauve);
    transform: translateY(-2px);
    box-shadow: 0 3px 10px rgba(var(--mauve-rgb), 0.5);
  }

  .mobile-cv {
    display: none;
  }

  .desktop-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .desktop-cv {
    display: inline-flex;
  }

  .mobile-actions {
    display: none;
    align-items: center;
    gap: 8px;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 10px;
    min-width: 44px;
    min-height: 44px;
    cursor: pointer;
  }

  .bar {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    margin: 4px 0;
    transition: transform 0.25s ease, opacity 0.25s ease;
  }

  .menu-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .titlebar-node {
      display: none;
    }

    .titlebar-container {
      padding: 4px 16px;
    }

    .navbar {
      padding: 0 20px;
      height: 60px;
    }

    .desktop-actions {
      display: none;
    }

    .mobile-actions {
      display: flex;
    }

    .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }

    .desktop-cv {
      display: none;
    }

    .mobile-cv {
      display: flex;
      width: 100%;
    }

    .nav-links {
      background: rgba(var(--crust-rgb), 0.96);
      backdrop-filter: blur(5px);
      display: none;
      position: absolute;
      width: 100%;
      left: 0;
      transform: none;
      align-items: start;
      top: 60px;
      flex-direction: column;
      padding: 16px 20px;
      gap: 8px;
      border-radius: 0 0 8px 8px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, 0.35);
      z-index: 9999;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      padding: 10px 12px;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      width: 100%;
    }

    .nav-link {
      font-size: 1rem;
      font-weight: 400;
    }

    .cv {
      width: 100%;
      justify-content: center;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .navbar {
      padding: 0 16px;
      height: 56px;
    }

    .logo {
      font-size: 1.1rem;
    }

    .nav-links {
      gap: 12px;
    }
  }
</style>

<script>
  const button = document.getElementById("menuToggle");
  const nav = document.getElementById("navLinks");

  if (button && nav) {
    button.addEventListener("click", () => {
      const isOpen = nav.classList.toggle("open");
      button.setAttribute("aria-expanded", String(isOpen));
      button.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("open")) {
        nav.classList.remove("open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú");
        button.focus();
      }
    });

    document.addEventListener("click", (e) => {
      if (
        nav.classList.contains("open") &&
        !nav.contains(e.target as Node) &&
        !button.contains(e.target as Node)
      ) {
        nav.classList.remove("open");
        button.setAttribute("aria-expanded", "false");
        button.setAttribute("aria-label", "Abrir menú");
      }
    });
  }
</script>
