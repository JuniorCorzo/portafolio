---
import { getGithubActivity } from "../lib/github";

interface Props {
  username?: string;
  class?: string;
}

const { username = "JuniorCorzo", class: className = "" } = Astro.props;

const activity = await getGithubActivity(username);
const { weeks, totalContributions, currentStreak, longestStreak, todayCount } = activity;

const MONTH_NAMES = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];

let prevMonth = -1;
const monthLabels = weeks.map((week) => {
  const firstDay = week[0];
  if (!firstDay) return "";
  const monthIndex = parseInt(firstDay.date.slice(5, 7), 10) - 1;
  if (monthIndex !== prevMonth) {
    prevMonth = monthIndex;
    return MONTH_NAMES[monthIndex];
  }
  return "";
});
---

<div class={`github-activity-terminal ${className}`} aria-label={`GitHub activity for ${username}`}>
  <div class="terminal-bar">
    <div class="terminal-controls">
      <span class="control-dot dot-close" aria-hidden="true"></span>
      <span class="control-dot dot-minimize" aria-hidden="true"></span>
      <span class="control-dot dot-maximize" aria-hidden="true"></span>
    </div>
    <div class="terminal-title">
      <span class="terminal-prompt">$</span> ACTIVITY // {username || "JuniorCorzo"}<!-- ACTIVITY // JuniorCorzo -->
    </div>
    <div class="terminal-counter">
      <span class="counter-number">{totalContributions}</span> in the last year
    </div>
  </div>

  <div class="terminal-body">
    <div class="heatmap-scroll">
      <div class="heatmap-container">
        <!-- Month labels -->
        <div class="months-row" aria-hidden="true">
          <div class="day-col-spacer"></div>
          <div class="months-track">
            {
              monthLabels.map((label) => (
                <div class="month-col">
                  {label && <span class="month-name">{label}</span>}
                </div>
              ))
            }
          </div>
        </div>

        <!-- Heatmap grid with day labels -->
        <div class="heatmap-content">
          <div class="days-column" aria-hidden="true">
            <span class="day-label spacer"></span>
            <span class="day-label">Mon</span>
            <span class="day-label spacer"></span>
            <span class="day-label">Wed</span>
            <span class="day-label spacer"></span>
            <span class="day-label">Fri</span>
            <span class="day-label spacer"></span>
          </div>

          <div
            class="weeks-grid"
            role="img"
            aria-label={`Calendario de contribuciones de GitHub: ${totalContributions} contribuciones en el último año`}
          >
            {
              weeks.map((week) =>
                week.map((day) => (
                  <div
                    class="day-square"
                    data-level={day.level}
                    data-date={day.date}
                    data-count={day.count}
                    title={`${day.date}: ${day.count} contribution${day.count === 1 ? "" : "s"}`}
                    aria-hidden="true"
                  />
                ))
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="terminal-footer">
    <div class="footer-stats">
      <span class="streak-badge">
        🔥 <strong>{currentStreak}</strong> day streak
      </span>
      <span class="stat-divider">·</span>
      <span class="stat-item">
        longest <strong>{longestStreak}</strong> days
      </span>
      <span class="stat-divider">·</span>
      <span class="stat-item">
        today <strong>{todayCount}</strong>
      </span>
    </div>

    <div class="footer-legend" aria-label="Contribution intensity legend">
      <span class="legend-text">Less</span>
      <span class="day-square legend-square" data-level="0" title="0 contributions"></span>
      <span class="day-square legend-square" data-level="1" title="1-3 contributions"></span>
      <span class="day-square legend-square" data-level="2" title="4-6 contributions"></span>
      <span class="day-square legend-square" data-level="3" title="7-9 contributions"></span>
      <span class="day-square legend-square" data-level="4" title="10+ contributions"></span>
      <span class="legend-text">More</span>
    </div>
  </div>
</div>

<style>
  .github-activity-terminal {
    width: 100%;
    background: var(--mantle);
    border: 1px solid rgba(var(--overlay0-rgb), 0.24);
    border-radius: 8px;
    font-family: var(--font-mono);
    color: var(--text);
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    margin: 32px 0 0;
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    background: var(--crust);
    border-bottom: 1px solid rgba(var(--overlay0-rgb), 0.18);
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .terminal-controls {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .control-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .dot-close {
    background: var(--red);
  }

  .dot-minimize {
    background: var(--yellow);
  }

  .dot-maximize {
    background: var(--green);
  }

  .terminal-title {
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--subtext1);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .terminal-prompt {
    color: var(--peach);
    font-weight: 700;
  }

  .terminal-counter {
    color: var(--subtext0);
    font-size: 0.8rem;
    margin-left: auto;
  }

  .counter-number {
    color: var(--green);
    font-weight: 700;
  }

  .terminal-body {
    padding: 18px 20px 12px;
  }

  .heatmap-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--surface2) transparent;
    padding-bottom: 6px;
    width: 100%;
  }

  .heatmap-scroll::-webkit-scrollbar {
    height: 6px;
  }

  .heatmap-scroll::-webkit-scrollbar-thumb {
    background: var(--surface2);
    border-radius: 3px;
  }

  .heatmap-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 680px;
  }

  .months-row {
    display: flex;
    margin-bottom: 6px;
    width: 100%;
  }

  .day-col-spacer {
    width: 28px;
    flex-shrink: 0;
  }

  .months-track {
    display: grid;
    grid-template-columns: repeat(52, minmax(0, 1fr));
    gap: 3px;
    width: 100%;
  }

  .month-col {
    position: relative;
    height: 14px;
  }

  .month-name {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 0.72rem;
    color: var(--overlay1);
    white-space: nowrap;
    line-height: 1;
    pointer-events: none;
  }

  .heatmap-content {
    display: flex;
    gap: 0;
    width: 100%;
    align-items: stretch;
  }

  .days-column {
    display: grid;
    grid-template-rows: repeat(7, minmax(0, 1fr));
    gap: 3px;
    width: 28px;
    flex-shrink: 0;
    align-items: center;
  }

  .day-label {
    font-size: 0.68rem;
    line-height: 1;
    color: var(--overlay1);
    user-select: none;
    display: flex;
    align-items: center;
  }

  .day-label.spacer {
    visibility: hidden;
  }

  .weeks-grid {
    display: grid;
    grid-template-columns: repeat(52, minmax(0, 1fr));
    grid-template-rows: repeat(7, minmax(0, 1fr));
    grid-auto-flow: column;
    gap: 3px;
    width: 100%;
  }

  .day-square {
    width: 100%;
    aspect-ratio: 1 / 1;
    height: auto;
    border-radius: 2px;
    transition: transform 0.15s ease, outline 0.15s ease;
    box-sizing: border-box;
  }

  .day-square:hover,
  .day-square:focus-visible {
    transform: scale(1.35);
    outline: 1.5px solid var(--peach);
    z-index: 10;
    position: relative;
  }

  /* Heatmap Color Scale (Catppuccin Noir/Latte Peach/Green) */
  .day-square[data-level="0"] {
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.22);
  }

  .day-square[data-level="1"] {
    background: color-mix(in srgb, var(--green) 35%, var(--surface0));
    border: 1px solid color-mix(in srgb, var(--green) 45%, transparent);
  }

  .day-square[data-level="2"] {
    background: color-mix(in srgb, var(--green) 65%, var(--surface0));
    border: 1px solid color-mix(in srgb, var(--green) 75%, transparent);
  }

  .day-square[data-level="3"] {
    background: var(--green);
    border: 1px solid var(--green);
  }

  .day-square[data-level="4"] {
    background: var(--peach);
    border: 1px solid var(--peach);
    box-shadow: 0 0 4px rgba(var(--peach-rgb), 0.5);
  }

  .terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 18px 12px;
    background: var(--crust);
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.18);
    font-size: 0.78rem;
    color: var(--subtext0);
    flex-wrap: wrap;
  }

  .footer-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .streak-badge {
    color: var(--peach);
  }

  .streak-badge strong {
    color: var(--peach);
  }

  .stat-item strong {
    color: var(--text);
  }

  .stat-divider {
    color: var(--overlay0);
  }

  .footer-legend {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: auto;
  }

  .legend-text {
    font-size: 0.72rem;
    color: var(--overlay1);
  }

  .legend-square {
    width: 11px !important;
    height: 11px !important;
    aspect-ratio: auto !important;
    display: inline-block;
  }

  @media (max-width: 640px) {
    .github-activity-terminal {
      margin-top: 24px;
    }

    .terminal-bar {
      padding: 8px 12px;
      font-size: 0.78rem;
    }

    .terminal-body {
      padding: 12px 10px 8px;
    }

    .terminal-footer {
      padding: 10px 12px;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .footer-legend {
      margin-left: 0;
    }
  }
</style>
