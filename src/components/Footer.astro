---
import { DEVELOPER_NAME } from "../data/site";
import VimHelpModal from "./VimHelpModal.astro";
import VimMode from "./VimMode.astro";

const today = new Date();
const brand = DEVELOPER_NAME.toLowerCase().replace(/\s+/g, "");
const footerJson = `{
  "built_with": ["Astro", "Tailwind", "☕"],
  "deployed_on": "Cloudflare Pages",
  "source": "github.com/angelcorzo/portafolio",
  "license": "MIT",
  "year": "${today.getFullYear()}"
}`;

const pathname = Astro.url.pathname;
let currentBuffer = "src/pages/index.astro";
if (pathname === "/servicios" || pathname === "/servicios/") {
  currentBuffer = "src/pages/servicios/index.astro";
} else if (pathname.startsWith("/servicios/")) {
  currentBuffer = "src/pages/servicios/[slug].astro";
} else if (pathname === "/sobre-mi" || pathname === "/sobre-mi/") {
  currentBuffer = "src/pages/sobre-mi.astro";
} else if (pathname === "/blog" || pathname === "/blog/") {
  currentBuffer = "src/pages/blog/index.astro";
} else if (pathname.startsWith("/blog/")) {
  currentBuffer = "src/pages/blog/[slug].astro";
} else if (pathname === "/contacto" || pathname === "/contacto/") {
  currentBuffer = "src/pages/contacto.astro";
}
---

<footer class="footer">
  <div class="terminal-statusbar">
    <div class="statusbar-container">
      <div class="statusbar-left">
        <span class="sb-mode" id="vimModeBadge">NORMAL</span>
        <span class="sb-branch"><span class="branch-sym" aria-hidden="true"></span> main*</span>
        <span class="sb-file" id="vimFileBuffer" title={currentBuffer}>{currentBuffer}</span>
        <span class="sb-ro" id="vimRoBadge" title="Modo lectura activo (nomodifiable)">[RO]</span>
      </div>
      <div class="statusbar-center" id="vimCmdContainer">
        <span class="statusbar-msg" id="vimStatusMsg" aria-live="polite"></span>
      </div>
      <div class="statusbar-right">
        <button type="button" class="sb-hint-btn" id="vimHelpToggle" aria-label="Abrir ayuda de Vim">
          <kbd class="vim-kbd">?</kbd> vim help
        </button>
        <span class="sb-item sb-desktop-only">utf-8</span>
        <span class="sb-item sb-desktop-only">astro</span>
        <span class="sb-item" id="vimScrollLine">Ln 0%</span>
      </div>
    </div>
  </div>

  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand"><span class="brand-prompt">$</span> {brand}</div>
      <div class="footer-links">
        <a href="/"><span class="tab-idx">1:</span>Inicio</a>
        <a href="/servicios"><span class="tab-idx">2:</span>Servicios</a>
        <a href="/sobre-mi"><span class="tab-idx">3:</span>Sobre mí</a>
        <a href="/blog"><span class="tab-idx">4:</span>Blog</a>
        <a href="/contacto"><span class="tab-idx">5:</span>Contacto</a>
      </div>
    </div>

    <div class="footer-json">
      <span class="key">// footer.json</span>
      <pre><code>{footerJson}</code></pre>
    </div>

    <div class="footer-bottom">© {today.getFullYear()} {DEVELOPER_NAME}. Hecho con café y código.</div>
  </div>

  <VimHelpModal />
  <VimMode />
</footer>

<style>
  .footer {
    background: var(--crust);
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.25);
    padding: 36px 0 calc(28px + 44px);
  }

  .terminal-statusbar {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 80;
    background: rgba(var(--crust-rgb), 0.95);
    backdrop-filter: blur(8px);
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.25);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
  }

  .statusbar-container {
    max-width: 1600px;
    width: 100%;
    margin: 0 auto;
    padding: 6px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    height: 34px;
    box-sizing: border-box;
  }

  .statusbar-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .sb-mode {
    background: var(--mauve);
    color: #000000;
    padding: 2px 7px;
    border-radius: 3px;
    font-weight: 800;
    letter-spacing: 0.04em;
    font-size: 0.72rem;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sb-mode.mode-visual {
    background: var(--yellow);
    color: #000000;
  }

  .sb-mode.mode-command {
    background: var(--green);
    color: #000000;
  }

  :global(html[data-theme="latte"]) .sb-mode {
    background: #8839ef;
    color: #ffffff;
  }

  :global(html[data-theme="latte"]) .sb-mode.mode-visual {
    background: #df8e1d;
    color: #ffffff;
  }

  :global(html[data-theme="latte"]) .sb-mode.mode-command {
    background: #40a02b;
    color: #ffffff;
  }

  .sb-branch {
    color: var(--peach);
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .branch-sym {
    font-style: normal;
  }

  .sb-file {
    color: var(--subtext1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }

  .sb-ro {
    color: var(--yellow);
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 1px 4px;
    border-radius: 2px;
    background: rgba(var(--yellow-rgb), 0.12);
  }

  .statusbar-center {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 0;
    padding: 0 8px;
    font-family: var(--font-mono);
  }

  .statusbar-msg {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .statusbar-msg.msg-warning {
    color: var(--yellow);
  }

  .statusbar-msg.msg-error {
    color: var(--red);
  }

  .statusbar-msg.msg-success {
    color: var(--green);
  }

  .statusbar-msg.msg-info {
    color: var(--sky);
  }



  .statusbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--overlay1);
    font-size: 0.72rem;
    flex-shrink: 0;
  }

  .sb-hint-btn {
    background: transparent;
    border: none;
    color: var(--subtext0);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    padding: 2px 6px;
    border-radius: 3px;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .sb-hint-btn:hover {
    background: rgba(var(--surface0-rgb), 0.8);
    color: var(--text);
  }

  .vim-kbd {
    background: var(--surface1);
    color: var(--mauve);
    border: 1px solid rgba(var(--overlay0-rgb), 0.4);
    border-radius: 3px;
    padding: 0 4px;
    font-size: 0.7rem;
    font-family: inherit;
  }

  .footer-container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 32px;
  }

  .footer-brand {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    font-family: var(--font-mono);
  }

  .brand-prompt {
    color: var(--mauve);
    font-weight: 700;
  }

  .footer-links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--subtext0);
    text-decoration: none;
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    border-radius: 4px;
    transition: all 0.2s ease;
    border: 1px solid transparent;
  }

  .footer-links a .tab-idx {
    color: var(--overlay1);
    font-weight: 700;
  }

  .footer-links a:hover {
    color: var(--mauve);
    background: rgba(var(--surface0-rgb), 0.5);
    border-color: rgba(var(--overlay0-rgb), 0.2);
  }

  .footer-json {
    color: var(--subtext0);
    line-height: 1.8;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .footer-json pre {
    margin: 0;
    white-space: pre-wrap;
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    padding: 18px;
    color: var(--text);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .footer-json code {
    font-family: inherit;
  }

  .key {
    color: var(--subtext1);
    display: block;
    margin-bottom: 8px;
  }

  .footer-bottom {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.25);
    text-align: center;
    color: var(--subtext1);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  @media (max-width: 768px) {
    .terminal-statusbar {
      display: none;
    }
    .footer {
      padding-bottom: 28px;
    }
    .sb-desktop-only {
      display: none;
    }
    .sb-file {
      max-width: 120px;
    }
    .sb-hint-btn {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding: 30px 0 24px;
    }

    .footer-links {
      gap: 14px;
    }

    .footer-json {
      font-size: 0.75rem;
    }
  }
</style>
