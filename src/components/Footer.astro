---
import { DEVELOPER_NAME } from "../data/site";

const today = new Date();
const brand = DEVELOPER_NAME.toLowerCase().replace(/\s+/g, "");
const footerJson = `{
  "built_with": ["HTML", "CSS", "☕"],
  "deployed_on": "Cloudflare Pages",
  "source": "github.com/angelcorzo/portafolio",
  "year": "${today.getFullYear()}"
}`;
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand"><span class="brand-prompt">$</span> {brand}</div>
      <div class="footer-links">
        <a href="/">Inicio</a>
        <a href="/servicios">Servicios</a>
        <a href="/sobre-mi">Sobre mí</a>
        <a href="/blog">Blog</a>
        <a href="/contacto">Contacto</a>
      </div>
    </div>

    <div class="footer-json">
      <span class="key">// footer.json</span>
      <pre><code>{footerJson}</code></pre>
    </div>

    <div class="footer-bottom">© {today.getFullYear()} {DEVELOPER_NAME}. Hecho con café y código.</div>
  </div>
</footer>

<style>
  .footer {
    background: var(--crust);
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.25);
    padding: 56px 0 28px;
  }

  .footer-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 32px;
  }

  .footer-brand {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--text);
    font-family: var(--font-mono);
  }

  .brand-prompt {
    color: var(--mauve);
    font-weight: 700;
  }

  .footer-links {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--subtext0);
    text-decoration: none;
    padding: 6px 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--mauve);
  }

  .footer-json {
    color: var(--subtext0);
    line-height: 1.8;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .footer-json pre {
    margin: 0;
    white-space: pre-wrap;
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    padding: 18px;
    color: var(--text);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .footer-json code {
    font-family: inherit;
  }

  .key {
    color: var(--subtext1);
    display: block;
    margin-bottom: 8px;
  }

  .str {
    color: var(--green);
  }

  .footer-bottom {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid rgba(var(--overlay0-rgb), 0.25);
    text-align: center;
    color: var(--subtext1);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  @media (max-width: 640px) {
    .footer {
      padding: 40px 0 24px;
    }

    .footer-links {
      gap: 14px;
    }

    .footer-json {
      font-size: 0.75rem;
    }
  }
</style>
