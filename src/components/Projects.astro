---
import { PROJECTS } from "../consts";
---

<section class="projects-section">
  <div class="projects-container">
    <header class="section-header">
      <h2 class="section-title">
        <span class="terminal-prefix">$</span> ls proyectos/destacados/
      </h2>
      <p class="section-subtitle">// casos de éxito recientes</p>
    </header>

    <div class="projects-grid">
      {
        PROJECTS.length > 0 ? (
          PROJECTS.map((project, index) => (
            <article class="project-card">
              <div class="project-header">// case-study-{index + 1}.md</div>
              <div class="project-body">
                <h3 class="project-title">{project.title}</h3>
                <p class="project-description">{project.description}</p>
                <p class="project-result">{project.results}</p>

                <div class="tech-stack">
                  {project.tech.map((tech) => (
                    <span class="tech-chip">{tech}</span>
                  ))}
                </div>

                <div class="project-links">
                  <a href={project.githubUrl} class="project-link github-link">GitHub</a>
                  <a href={project.caseStudyUrl} class="project-link case-study-link">
                    Caso de Estudio
                  </a>
                </div>
              </div>
            </article>
          ))
        ) : (
          <article class="project-empty">
            <span class="project-empty-label">// no-projects.md</span>
            <h3 class="project-empty-title">Aún no tengo proyectos públicos</h3>
            <p class="project-empty-text">
              Estoy enfocado en servicios y trabajo privado. Si querés, te cuento qué puedo construir para tu caso.
            </p>
            <div class="project-empty-actions">
              <a href="/servicios" class="project-link github-link">Ver servicios</a>
              <a href="/contacto" class="project-link case-study-link">Hablemos</a>
            </div>
          </article>
        )
      }
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: 80px 24px;
    background: var(--mantle);
    border-top: 1px solid var(--overlay0);
  }

  .projects-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    color: var(--text);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .terminal-prefix {
    font-family: var(--font-mono);
    color: var(--overlay1);
    font-size: 2.2rem;
    font-weight: 400;
    user-select: none;
  }

  .section-subtitle {
    color: var(--subtext0);
    font-size: 1rem;
    font-family: var(--font-mono);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .project-card {
    background: var(--surface0);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    transition: all 0.3s ease-in-out;
    display: flex;
    flex-direction: column;
  }

  .project-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    background: var(--surface1);
  }

  .project-header {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--subtext1);
    margin: 0;
    padding: 1.25rem 1.5rem 0;
    user-select: none;
  }

  .project-body {
    padding: 12px 24px 24px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .project-title {
    color: var(--text);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 12px 0;
  }

  .project-description {
    color: var(--subtext0);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 20px 0;
  }

  .project-result {
    margin: 0 0 20px 0;
    color: var(--sky);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .tech-chip {
    display: inline-block;
    background: rgba(var(--sky-rgb), 0.08);
    color: var(--sky);
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 0.8rem;
    font-weight: 500;
    border: 1px solid var(--sky);
  }

  .project-links {
    display: flex;
    gap: 12px;
    align-items: center;
    margin-top: auto;
  }

  .project-empty {
    grid-column: 1 / -1;
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    padding: 32px;
    text-align: center;
  }

  .project-empty-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--subtext1);
    margin-bottom: 12px;
  }

  .project-empty-title {
    margin: 0 0 12px 0;
    color: var(--text);
    font-size: 1.5rem;
  }

  .project-empty-text {
    margin: 0 auto 20px;
    max-width: 48ch;
    color: var(--subtext0);
    line-height: 1.6;
  }

  .project-empty-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .project-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 1;
    padding: 8px 14px;
    min-height: 40px;
    border-radius: 6px;
    font-size: 0.92rem;
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: all 0.3s ease-in-out;
    line-height: 1.2;
    white-space: nowrap;
  }

  .github-link {
    background: var(--mauve);
    color: var(--crust);
    border: 2px solid var(--mauve);
    font-weight: 600;
  }

  .github-link:hover {
    background: #b089e5;
    border-color: #b089e5;
  }

  .case-study-link {
    background: transparent;
    color: var(--text);
    border: 2px solid var(--overlay0);
  }

  .case-study-link:hover {
    border-color: var(--sky);
    color: var(--sky);
  }

  @media (max-width: 1024px) {
    .projects-section {
      padding: 60px 24px;
    }

    .section-title {
      font-size: 2rem;
      margin-bottom: 40px;
    }

    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (max-width: 640px) {
    .section-title {
      font-size: 1.5rem;
    }

    .terminal-prefix {
      font-size: 1.5rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
