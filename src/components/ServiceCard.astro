---
import { Icon } from "astro-icon/components";
import { LINKEDIN_SERVICES_URL } from "../data/contact";
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-card">
  <header class="service-header">
    <span class="service-file">// {service.slug}.ts</span>
    {service.icon && <Icon name={service.icon} size={22} class="service-header-icon" />}
  </header>

  <h3 class="service-title">{service.title}</h3>
  <p class="service-description">{service.description}</p>

  <div class="service-tech">
    {service.tech.map((t) => <span class="tech-chip">{t}</span>)}
  </div>

  <div class="service-actions">
    <a href={`/servicios/${service.slug}`} class="service-link">
      <span class="link-prompt">&gt;</span> Ver servicio <Icon name="lucide:arrow-right" size={15} />
    </a>
    <a
      href={LINKEDIN_SERVICES_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="service-linkedin-link"
      aria-label={`Solicitar ${service.title} en LinkedIn`}
    >
      <Icon name="lucide:linkedin" size={14} /> LinkedIn <Icon name="lucide:external-link" size={12} />
    </a>
  </div>
</article>

<style>
  .service-card {
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    padding: 1.5rem;
    transition: background 160ms var(--ease-out), border-color 160ms var(--ease-out), transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .service-card:active {
    transform: scale(0.99);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      background: var(--surface1);
      transform: translateY(-2px);
      box-shadow: var(--shadow-md);
      border-color: var(--mauve);
    }
  }

  .service-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }

  .service-header-icon {
    color: var(--teal);
    flex-shrink: 0;
  }

  .service-file {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--subtext1);
    user-select: none;
  }

  .service-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text);
    margin: 0 0 12px 0;
  }

  .service-description {
    color: var(--subtext0);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 16px 0;
    flex-grow: 1;
  }

  .service-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .tech-chip {
    display: inline-block;
    background: rgba(var(--sky-rgb), 0.08);
    color: var(--sky);
    padding: 4px 12px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    border: 1px solid var(--sky);
  }

  .service-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 8px;
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--sky);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .service-linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 10px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--mauve);
    background: rgba(var(--mauve-rgb), 0.1);
    border: 1px solid rgba(var(--mauve-rgb), 0.3);
    text-decoration: none;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out), transform 140ms var(--ease-out);
  }

  .service-link:active,
  .service-linkedin-link:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .service-link:hover {
      color: var(--sapphire);
      transform: translateX(2px);
    }

    .service-linkedin-link:hover {
      background: rgba(var(--mauve-rgb), 0.2);
      border-color: var(--mauve);
      color: var(--text);
      transform: translateY(-1px);
    }
  }

  .link-prompt {
    font-family: var(--font-mono);
    user-select: none;
  }
</style>
