---
import { TESTIMONIALS } from "../data/trust";

interface Props {
  reviews?: typeof TESTIMONIALS;
}

const { reviews = TESTIMONIALS } = Astro.props;
---

<section class="testimonials-section">
  <div class="testimonials-container">
    <header class="testimonials-header">
      <h2 class="section-title">
        <span class="terminal-prefix">//</span> reviews.log
      </h2>
      <p class="section-subtitle"># lo que dicen los clientes</p>
    </header>

    <div class="testimonials-grid">
      {
        reviews.length > 0 ? (
          reviews.map((review) => (
            <blockquote class="testimonial-card">
              <div class="testimonial-prompt">
                <span class="prompt">&gt;</span>
                <span class="reviewer-name">{review.name}</span>
                <span class="reviewer-meta">
                  {review.role} · {review.company}
                </span>
              </div>
              <p class="testimonial-text">{review.text}</p>
            </blockquote>
          ))
        ) : (
          <div class="testimonial-empty">
            <span class="prompt">&gt;</span>
            <p class="testimonial-empty-text">
              Próximamente: opiniones de clientes reales.
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .testimonials-section {
    padding: 80px 24px;
    background: linear-gradient(180deg, var(--crust) 0%, var(--base) 100%);
    border-top: 1px solid var(--overlay0);
  }

  .testimonials-container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .testimonials-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-title {
    color: var(--text);
    font-size: 2.5rem;
    font-weight: 700;
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .terminal-prefix {
    font-family: var(--font-mono);
    color: var(--overlay1);
    font-size: 2.2rem;
    font-weight: 400;
    user-select: none;
  }

  .section-subtitle {
    color: var(--subtext0);
    font-size: 1rem;
    font-family: var(--font-mono);
    margin: 0;
  }

  .testimonials-grid {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .testimonial-card {
    background: var(--surface0);
    border: 1px solid rgba(var(--overlay0-rgb), 0.3);
    border-radius: 8px;
    padding: 28px;
    margin: 0;
    transition: all 0.3s ease-in-out;
  }

  .testimonial-card:hover {
    background: var(--surface1);
    border-color: var(--mauve);
    transform: translateY(-2px);
  }

  .testimonial-prompt {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }

  .prompt {
    font-family: var(--font-mono);
    color: var(--green);
    font-size: 1rem;
    user-select: none;
  }

  .reviewer-name {
    color: var(--text);
    font-weight: 700;
    font-size: 1rem;
  }

  .reviewer-meta {
    color: var(--overlay1);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }

  .testimonial-text {
    color: var(--subtext0);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
    padding-left: 24px;
    border-left: 2px solid var(--overlay0);
  }

  .testimonial-empty {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface0);
    border: 1px dashed var(--overlay0);
    border-radius: 8px;
    padding: 28px;
  }

  .testimonial-empty-text {
    color: var(--overlay1);
    font-size: 0.95rem;
    font-family: var(--font-mono);
    margin: 0;
  }

  @media (max-width: 1024px) {
    .testimonials-section {
      padding: 60px 24px;
    }

    .section-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 640px) {
    .testimonials-section {
      padding: 40px 24px;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .terminal-prefix {
      font-size: 1.5rem;
    }

    .testimonial-card {
      padding: 20px;
    }

    .testimonial-text {
      padding-left: 16px;
    }
  }
</style>
